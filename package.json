{
  "name": "ai-agents-website",
  "type": "module",
  "version": "1.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "node scripts/test-run.mjs unit test tests/unit --reporter=list",
    "test:consent": "node scripts/test-run.mjs consent test tests/consent/consent-flow.spec.ts tests/consent/cookie-list.spec.ts --reporter=list",
    "test:tracking": "node scripts/test-run.mjs tracking test tests/tracking --reporter=list",
    "test:sections": "node scripts/test-run.mjs sections test tests/screenshots --reporter=list",
    "test:a11y": "node scripts/test-run.mjs a11y test tests/a11y --reporter=list",
    "test:cookies": "node scripts/test-run.mjs cookies test tests/consent/cookie-check.spec.ts --workers=4 --reporter=list",
    "test:cookies:prod": "node scripts/test-run.mjs cookies-prod --base-url=https://agents.creativesparks.pl test tests/consent/cookie-check.spec.ts --workers=4 --reporter=list"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.5",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-mono": "^5.2.10",
    "@neondatabase/serverless": "1.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.1",
    "tailwindcss": "^4.2.2",
    "vanilla-cookieconsent": "3.3.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "subset-font": "^2.5.0"
  },
  "overrides": {
    "path-to-regexp": "^8.4.2"
  }
}
