---
import { getCollection } from 'astro:content';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import HeroSection from '../../components/sections/hero/HeroSection.astro';
import processIcon from '../../assets/icons/shape-3.svg';
import proofIcon from '../../assets/icons/shape-2.svg';
import useCasesIcon from '../../assets/icons/shape-1.svg';
import valuePropsIcon from '../../assets/icons/shape-4.svg';
import demoIconDS from '../../assets/icons/shape-10.svg';
import freeTrialIconDS from '../../assets/icons/shape-6.svg';
import problemsIconDS from '../../assets/icons/shape-4.svg';
import installIconDS from '../../assets/icons/shape-7.svg';
import { localeFromPathname, requireEntry, requireLocalizedEntry, getLocalizedCollection } from '../../lib/i18n';

const locale = localeFromPathname(Astro.url.pathname);

const stages = (await getLocalizedCollection('process', locale))
  .sort((a, b) => a.data.order - b.data.order);
const processCards = stages.map((s) => ({
  title: s.data.title,
  description: s.body?.trim() ?? '',
  output: s.data.output,
  outputLink: s.data.outputLink,
  outputIcon: s.data.outputIcon,
  quote: s.data.quote,
  shape: s.data.shape,
}));

const proofEntry = await requireLocalizedEntry('proof-gallery', locale);
const proofCards = proofEntry.data.cards.map((c) => ({
  title: c.title,
  description: c.description,
  shape: c.shape,
  output: c.link.label,
  outputLink: c.link.href,
  outputIcon: 'description',
}));

const valuePropsEntry = await requireLocalizedEntry('value-props', locale);
const valuePropsCases = valuePropsEntry.data.cards.map((c, i) => ({
  number: String(i + 1).padStart(2, '0'),
  title: c.title,
  description: c.description,
  links: c.links,
}));

const useCases = (await getLocalizedCollection('use-cases', locale))
  .sort((a, b) => a.data.order - b.data.order);
const useCasesCases = useCases.map((u) => ({
  number: u.data.number,
  audience: u.data.audience,
  title: u.data.title,
  description: u.body?.trim() ?? '',
  bullets: u.data.bullets,
  quote: u.data.quote,
  links: u.data.links,
}));

const useCasesExamples = (await requireLocalizedEntry('use-cases-examples', locale)).data.examples;

const demoEntryDS = await requireLocalizedEntry('demo', locale);
const freeTrialEntryDS = await requireLocalizedEntry('free-trial', locale);
const installEntryDS = await requireLocalizedEntry('install', locale);

const problemsItemsDS = (await getLocalizedCollection('problems', locale))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    icon: p.data.icon,
    title: p.data.title,
    description: p.body?.trim() ?? '',
  }));
import UseCasesSection from '../../components/sections/use-cases/UseCasesSection.astro';
import ProblemsSection from '../../components/sections/problems/ProblemsSection.astro';
import LandscapeSection from '../../components/sections/landscape/LandscapeSection.astro';
import ComparisonSection from '../../components/sections/comparison/ComparisonSection.astro';
import ProcessSection from '../../components/sections/process/ProcessSection.astro';
import PricingSection from '../../components/sections/pricing/PricingSection.astro';
import DemoSection from '../../components/sections/demo/DemoSection.astro';
import PlatformSection from '../../components/sections/platform/PlatformSection.astro';
import KnowledgeBaseSection from '../../components/sections/knowledge-base/KnowledgeBaseSection.astro';
import ArchitectureSection from '../../components/sections/architecture/ArchitectureSection.astro';
import FAQSection from '../../components/sections/faqs/FAQSection.astro';
import AuthorSection from '../../components/sections/author/AuthorSection.astro';
import ChangelogSection from '../../components/sections/changelog/ChangelogSection.astro';
import TopAppBar from '../../components/sections/top-app-bar/TopAppBar.astro';
import Footer from '../../components/sections/footer/Footer.astro';

const sections = [
  { id: 'hero', name: 'HeroSection', collection: 'hero', anchor: 'HeroSection' },
  { id: 'value-props', name: 'UseCasesSection (value-props data)', collection: 'value-props', anchor: 'ValuePropsSection' },
  { id: 'use-cases', name: 'UseCasesSection (use-cases data)', collection: 'use-cases (+ use-cases-examples)', anchor: 'UseCasesSection' },
  { id: 'problems', name: 'ProblemsSection (problems data)', collection: 'problems', anchor: 'ProblemsSection' },
  { id: 'install', name: 'ProblemsSection (install data)', collection: 'install', anchor: 'InstallSection' },
  { id: 'landscape', name: 'LandscapeSection', collection: 'landscape', anchor: 'LandscapeSection' },
  { id: 'comparison', name: 'ComparisonSection', collection: 'comparison', anchor: 'ComparisonSection' },
  { id: 'proof-gallery', name: 'ProcessSection (proof-gallery data)', collection: 'proof-gallery', anchor: 'ProofGallerySection' },
  { id: 'process', name: 'ProcessSection (process data)', collection: 'process', anchor: 'ProcessSection' },
  { id: 'pricing', name: 'PricingSection', collection: 'pricing', anchor: 'PricingSection' },
  { id: 'demo', name: 'DemoSection (demo data)', collection: 'demo', anchor: 'DemoSection' },
  { id: 'free-trial', name: 'DemoSection (free-trial data)', collection: 'free-trial', anchor: 'FreeTrialSection' },
  { id: 'platform', name: 'PlatformSection', collection: 'platform', anchor: 'PlatformSection' },
  { id: 'knowledge-base', name: 'KnowledgeBaseSection', collection: 'knowledge-base', anchor: 'KnowledgeBaseSection' },
  { id: 'architecture', name: 'ArchitectureSection', collection: 'architecture', anchor: 'ArchitectureSection' },
  { id: 'faqs', name: 'FAQSection', collection: 'faqs', anchor: 'FAQSection' },
  { id: 'author', name: 'AuthorSection', collection: 'author', anchor: 'AuthorSection' },
  { id: 'changelog', name: 'ChangelogSection', collection: 'changelog', anchor: 'ChangelogSection' },
  { id: 'top-app-bar', name: 'TopAppBar', collection: 'nav', anchor: 'TopAppBar' },
  { id: 'footer', name: 'Footer', collection: 'footer', anchor: 'Footer' },
];
---

<PreviewLayout title="Sections" current="sections">
  <div class="bg-foreground text-background py-6 sticky top-[88px] z-40">
    <div class="max-w-screen-2xl mx-auto px-6">
      <p class="font-label text-xs uppercase tracking-widest text-background/60 mb-3">Jump to section</p>
      <div class="flex flex-wrap gap-2">
        {sections.map((s) => (
          <a href={`#${s.anchor}`} class="px-3 py-1.5 bg-background/10 hover:bg-accent hover:text-foreground transition-colors font-label text-xs">
            {s.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-6 py-12">
    <p class="text-sm text-muted leading-relaxed">
      Every section rendered live with its default content from <code class="font-label bg-surface-primary px-1">src/content/&lt;collection&gt;/pl/</code>. Layouts here match what ships on the site exactly. Headings of each preview block name the section + collection.
    </p>
  </div>

  <div class="space-y-px bg-border">

    <article id="HeroSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">HeroSection</h2>
        <span class="font-label text-xs text-background/60">collection: hero</span>
      </header>
      <HeroSection />
    </article>

    <article id="TopAppBar" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">TopAppBar</h2>
        <span class="font-label text-xs text-background/60">collection: nav</span>
      </header>
      <div class="border-y border-border"><TopAppBar /></div>
    </article>

    <article id="ValuePropsSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">UseCasesSection (value-props data)</h2>
        <span class="font-label text-xs text-background/60">collection: value-props</span>
      </header>
      <UseCasesSection
        headingId="ds-value-props-heading"
        badge="Wartość"
        heading={valuePropsEntry.data.heading}
        cases={valuePropsCases}
        icon={valuePropsIcon}
        groupName="ds-value-props"
      />
    </article>

    <article id="UseCasesSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">UseCasesSection (use-cases data)</h2>
        <span class="font-label text-xs text-background/60">collections: use-cases + use-cases-examples</span>
      </header>
      <UseCasesSection
        headingId="ds-use-cases-heading"
        badge="Zastosowanie"
        heading={'Co możesz z tym zrobić?<br class="hidden md:block" /> Ta strona to jeden z przykładów.'}
        cases={useCasesCases}
        examples={{
          badge: 'Przykłady',
          heading: 'Przykłady efektów współpracy z&nbsp;asystentem&nbsp;UX',
          items: useCasesExamples,
        }}
        icon={useCasesIcon}
        groupName="ds-use-cases"
      />
    </article>

    <article id="ProofGallerySection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">ProcessSection (proof-gallery data)</h2>
        <span class="font-label text-xs text-background/60">collection: proof-gallery</span>
      </header>
      <ProcessSection
        headingId="ds-proof-gallery-heading"
        badge={proofEntry.data.badge}
        heading={proofEntry.data.heading}
        lead={proofEntry.data.lead}
        cards={proofCards}
        icon={proofIcon}
      />
    </article>

    <article id="ProcessSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">ProcessSection (process data)</h2>
        <span class="font-label text-xs text-background/60">collection: process</span>
      </header>
      <ProcessSection
        headingId="ds-process-heading"
        badge="Jak to działa"
        heading="Cztery kroki od briefu<br/>do gotowej makiety z treściami"
        cards={processCards}
        icon={processIcon}
      />
    </article>

    <article id="PricingSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">PricingSection</h2>
        <span class="font-label text-xs text-background/60">collection: pricing</span>
      </header>
      <PricingSection />
    </article>

    <article id="DemoSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">DemoSection (demo data)</h2>
        <span class="font-label text-xs text-background/60">collection: demo</span>
      </header>
      <DemoSection
        badge={demoEntryDS.data.badge}
        heading={demoEntryDS.data.heading}
        intro={demoEntryDS.data.intro}
        stages={demoEntryDS.data.stages}
        cta={demoEntryDS.data.cta}
        icon={demoIconDS}
      />
    </article>

    <article id="FreeTrialSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">DemoSection (free-trial data)</h2>
        <span class="font-label text-xs text-background/60">collection: free-trial</span>
      </header>
      <DemoSection
        badge={freeTrialEntryDS.data.badge}
        heading={freeTrialEntryDS.data.heading}
        intro={freeTrialEntryDS.data.intro}
        stages={freeTrialEntryDS.data.stages}
        note={freeTrialEntryDS.data.note}
        cta={freeTrialEntryDS.data.cta}
        icon={freeTrialIconDS}
      />
    </article>

    <article id="PlatformSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">PlatformSection</h2>
        <span class="font-label text-xs text-background/60">collection: platform</span>
      </header>
      <PlatformSection />
    </article>

    <article id="ProblemsSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">ProblemsSection (problems data)</h2>
        <span class="font-label text-xs text-background/60">collection: problems</span>
      </header>
      <ProblemsSection
        headingId="ds-problems-heading"
        badge="Problem"
        heading={'UX bywa tym etapem, na&nbsp;który "nie&nbsp;ma&nbsp;czasu".'}
        items={problemsItemsDS}
        columns={4}
        icon={problemsIconDS}
      />
    </article>

    <article id="InstallSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">ProblemsSection (install data)</h2>
        <span class="font-label text-xs text-background/60">collection: install</span>
      </header>
      <ProblemsSection
        headingId="ds-install-heading"
        badge={installEntryDS.data.badge}
        heading={installEntryDS.data.heading}
        intro={installEntryDS.data.intro}
        items={installEntryDS.data.items}
        columns={3}
        footerNote={installEntryDS.data.footerNote}
        footerLink={installEntryDS.data.footerLink}
        icon={installIconDS}
      />
    </article>

    <article id="LandscapeSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">LandscapeSection</h2>
        <span class="font-label text-xs text-background/60">collection: landscape</span>
      </header>
      <LandscapeSection />
    </article>

    <article id="ArchitectureSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">ArchitectureSection</h2>
        <span class="font-label text-xs text-background/60">collection: architecture</span>
      </header>
      <ArchitectureSection />
    </article>

    <article id="ComparisonSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">ComparisonSection</h2>
        <span class="font-label text-xs text-background/60">collection: comparison</span>
      </header>
      <ComparisonSection />
    </article>

    <article id="KnowledgeBaseSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">KnowledgeBaseSection</h2>
        <span class="font-label text-xs text-background/60">collection: knowledge-base</span>
      </header>
      <KnowledgeBaseSection />
    </article>

    <article id="FAQSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">FAQSection</h2>
        <span class="font-label text-xs text-background/60">collection: faqs</span>
      </header>
      <FAQSection />
    </article>

    <article id="AuthorSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">AuthorSection</h2>
        <span class="font-label text-xs text-background/60">collection: author</span>
      </header>
      <AuthorSection />
    </article>

    <article id="ChangelogSection" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">ChangelogSection</h2>
        <span class="font-label text-xs text-background/60">collection: changelog</span>
      </header>
      <ChangelogSection />
    </article>

    <article id="Footer" class="bg-background">
      <header class="bg-foreground text-background px-6 py-4 max-w-screen-2xl mx-auto flex items-baseline justify-between gap-4">
        <h2 class="font-headline font-bold">Footer</h2>
        <span class="font-label text-xs text-background/60">collection: footer</span>
      </header>
      <Footer />
    </article>

  </div>
</PreviewLayout>
