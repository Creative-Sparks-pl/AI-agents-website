---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopAppBar from '../../../components/sections/top-app-bar/TopAppBar.astro';
import HeroSection from '../../../components/sections/hero/HeroSection.astro';
import ProblemsSection from '../../../components/sections/problems/ProblemsSection.astro';
import ProcessSection from '../../../components/sections/process/ProcessSection.astro';
import DemoSection from '../../../components/sections/demo/DemoSection.astro';
import FreeSkillForm from '../../../components/ui/FreeSkillForm.astro';
import ArchitectureSection from '../../../components/sections/architecture/ArchitectureSection.astro';
import FAQSection from '../../../components/sections/faqs/FAQSection.astro';
import AuthorSection from '../../../components/sections/author/AuthorSection.astro';
import Footer from '../../../components/sections/footer/Footer.astro';
import proofIcon from '../../../assets/icons/shape-2.svg';
import installIcon from '../../../assets/icons/shape-7.svg';
import boundariesIcon from '../../../assets/icons/shape-8.svg';
import finalCtaIcon from '../../../assets/icons/shape-9.svg';
import { localeFromPathname, requireEntry, requireLocalizedEntry, localizedId } from '../../../lib/i18n';

const locale = localeFromPathname(Astro.url.pathname);

const installEntry = await requireLocalizedEntry('install', locale);

const boundariesEntry = await requireEntry('boundaries', localizedId('free-audit-skill', locale), 'free-audit-skill');

const finalCtaEntry = await requireEntry('final-cta', localizedId('free-audit-skill', locale), 'free-audit-skill');

const faqEntries = [
  {
    q: 'What do I get exactly?',
    body: 'An HTML file you open in the browser. Inside: a wireframe rebuilt from your site as a lo-fi sketch, findings as annotations pinned to sections and elements, each finding comparing the current state to the standard for your site type, with a confidence level (high, medium, low). Plus a short list of changes that follow from the audit.',
  },
  {
    q: 'What does the skill do with my site? What data does it send?',
    body: 'The skill fetches the publicly available version of your site (the same one every visitor sees) and analyzes the structure inside your AI model. Nothing comes back to our server (we don\'t have a server). The skill lives locally in your Claude Code, Cursor, or ChatGPT. Your AI model API key stays with you.',
  },
  {
    q: 'What if the skill can\'t handle my site type?',
    body: "The skill audits four site types: designer portfolio, studio site (or small agency), your own digital product, your own SaaS landing page. If your site sits between two types, the skill says it plainly: 'recognized as X with medium confidence' and runs the audit with that flagged on every finding.",
  },
  {
    q: 'How is this different from the full UX Design Skill package?',
    body: 'This skill diagnoses an existing site: shows what\'s there, where it deviates from the standard, with what confidence. The full UX Design Skill package runs the whole design process from brief to a finished wireframe with copy: discovery, strategy, section plan, copy, wireframes. If the audit shows your site needs a redesign, the full package designs it.',
    link: { label: 'See the full UX Design Skill', href: '/en/ux-design-skill/' },
  },
];

const proofEntry = await requireEntry('proof-gallery', localizedId('free-audit-skill', locale), 'free-audit-skill');
const proofCards = proofEntry.data.cards.map((c) => ({
  title: c.title,
  description: c.description,
  shape: c.shape,
  output: c.link.label,
  outputLink: c.link.href,
  outputIcon: 'description',
  trackEvent: 'ViewContent',
  trackParams: { content_name: 'value_props_free_audit', content_id: c.title },
}));

const architectureDecisions = [
  {
    icon: 'account_tree',
    label: '01',
    title: 'Knowledge separated from instructions.',
    desc: 'AGENTS.md defines the audit logic. The references/ folder holds the industry standards for each site type.',
  },
  {
    icon: 'auto_awesome',
    label: '02',
    title: 'Knowledge pack loaded after the type is detected.',
    desc: 'The skill detects your site type and loads only the patterns for that category, instead of running a generic checklist.',
  },
  {
    icon: 'verified',
    label: '03',
    title: 'Every finding shows its confidence level.',
    desc: 'Three levels: high, medium, low. Wherever the AI is guessing, we flag it directly on the annotation.',
  },
  {
    icon: 'troubleshoot',
    label: '04',
    title: 'The audit delivers the diagnosis.',
    desc: 'The skill generates findings compared to the industry standard. Decisions about changes stay with you.',
  },
];

// Single-funnel LP: logo-only header (non-sticky, no nav, no CTA).
// The hero's primary CTA (checkout) and secondary CTA (instrukcja) carry the only off-page actions.
const navLinks: { label: string; href: string }[] = [];
---

<BaseLayout
  title="Free UX Audit Skill: UX audit of your site, run in Claude Code | Creative Sparks"
  description="A free UX audit skill that runs in Claude Code on your own site. Returns a wireframe with findings pinned to each section. 4 site types, 3 confidence levels, one HTML file."
  ogTitle="Audit your site with the free UX skill in Claude Code"
  ogDescription="Give it a URL. The skill returns an HTML file with your site as a wireframe and per-section findings."
  ogImage="/uxd-share.jpg"
>
  <TopAppBar navLinks={navLinks} showCta={false} sticky={false} />
  <main>
    <HeroSection entryId="free-audit-skill">
      <FreeSkillForm
        slot="primary-cta"
        size="lg"
        surface="free_audit_skill_hero"
        block
      />
    </HeroSection>
    <ProcessSection
      id="co-dostajesz"
      headingId="value-props-heading"
      badge={proofEntry.data.badge}
      heading={proofEntry.data.heading}
      lead={proofEntry.data.lead}
      cards={proofCards}
      icon={proofIcon}
    />
    <ArchitectureSection
      badge="Under the hood"
      heading="Not just a prompt.<br />A slice of the UX Design Skill system."
      lead="The audit uses the same mature architecture as the full UX Design Skill package: AGENTS.md as the operating playbook, domain knowledge packs loaded after the site type is detected. The architecture took months to get right in the full package. The audit is the slice that loads four of the sixteen site-type knowledge packs."
      link={null}
      decisions={architectureDecisions}
      cta={{
        heading: 'What you get in the full UX Design Skill',
        description: 'The audit shows the diagnosis of an existing site. The full skill runs the whole design process: discovery, strategy, section plan, copy, and wireframes, every decision with its reasoning.',
        button: { label: 'See UX Design Skill', href: '/en/ux-design-skill/' },
      }}
    />
    <ProblemsSection
      id="granice"
      headingId="boundaries-heading"
      badge={boundariesEntry.data.badge}
      heading={boundariesEntry.data.heading}
      items={boundariesEntry.data.items}
      columns={2}
      icon={boundariesIcon}
      class="!bg-surface"
    />
    <ProblemsSection
      headingId="install-heading"
      badge={installEntry.data.badge}
      heading={installEntry.data.heading}
      intro={installEntry.data.intro}
      items={installEntry.data.items}
      columns={3}
      footerNote={installEntry.data.footerNote}
      footerLink={installEntry.data.footerLink}
      icon={installIcon}
    />
    <FAQSection entries={faqEntries} />
    <AuthorSection />
    <DemoSection
      heading={finalCtaEntry.data.heading}
      intro={finalCtaEntry.data.intro}
      note={finalCtaEntry.data.note}
      icon={finalCtaIcon}
    >
      <FreeSkillForm slot="cta" surface="free_audit_skill_final" block class="sm:max-w-2xl" />
    </DemoSection>
  </main>
  <Footer />
</BaseLayout>
