---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopAppBar from '../../../components/sections/top-app-bar/TopAppBar.astro';
import HeroSection from '../../../components/sections/hero/HeroSection.astro';
import UseCasesSection from '../../../components/sections/use-cases/UseCasesSection.astro';
import ProblemsSection from '../../../components/sections/problems/ProblemsSection.astro';
import ComparisonSection from '../../../components/sections/comparison/ComparisonSection.astro';
import ProcessSection from '../../../components/sections/process/ProcessSection.astro';
import PricingSection from '../../../components/sections/pricing/PricingSection.astro';
import DemoSection from '../../../components/sections/demo/DemoSection.astro';
import FreeSkillForm from '../../../components/ui/FreeSkillForm.astro';
import ArchitectureSection from '../../../components/sections/architecture/ArchitectureSection.astro';
import PlatformSection from '../../../components/sections/platform/PlatformSection.astro';
import KnowledgeBaseSection from '../../../components/sections/knowledge-base/KnowledgeBaseSection.astro';
import LandscapeSection from '../../../components/sections/landscape/LandscapeSection.astro';
import FAQSection from '../../../components/sections/faqs/FAQSection.astro';
import AuthorSection from '../../../components/sections/author/AuthorSection.astro';
import Footer from '../../../components/sections/footer/Footer.astro';
import processIcon from '../../../assets/icons/shape-3.svg';
import proofIcon from '../../../assets/icons/shape-2.svg';
import valuePropsIcon from '../../../assets/icons/shape-4.svg';
import freeTrialIcon from '../../../assets/icons/shape-6.svg';
import installIcon from '../../../assets/icons/shape-7.svg';
import boundariesIcon from '../../../assets/icons/shape-8.svg';
import finalCtaIcon from '../../../assets/icons/shape-9.svg';
import { localeFromPathname, requireEntry, requireLocalizedEntry, getLocalizedCollection, localizedId } from '../../../lib/i18n';

const locale = localeFromPathname(Astro.url.pathname);

const stages = (await getLocalizedCollection('process', locale))
  .sort((a, b) => a.data.order - b.data.order);

const processCards = stages.map((s) => ({
  title: s.data.title,
  description: s.body?.trim() ?? '',
  output: s.data.output,
  outputLink: s.data.outputLink,
  outputIcon: s.data.outputIcon,
  quote: s.data.quote,
  shape: s.data.shape,
}));

const freeTrialEntry = await requireLocalizedEntry('free-trial', locale);

const installEntry = await requireLocalizedEntry('install', locale);

const boundariesEntry = await requireLocalizedEntry('boundaries', locale);

const finalCtaEntry = await requireLocalizedEntry('final-cta', locale);

const proofEntry = await requireEntry('proof-gallery', localizedId('skill-lp', locale), 'skill-lp');
const proofCards = proofEntry.data.cards.map((c) => ({
  title: c.title,
  description: c.description,
  shape: c.shape,
  output: c.link.label,
  outputLink: c.link.href,
  outputIcon: 'description',
  trackEvent: 'ViewContent',
  trackParams: { content_name: 'proof_gallery', content_id: c.title },
}));

const valuePropsEntry = await requireEntry('value-props', localizedId('skill-lp', locale), 'skill-lp');
const valuePropsCases = valuePropsEntry.data.cards.map((c, i) => ({
  number: String(i + 1).padStart(2, '0'),
  title: c.title,
  description: c.description,
  links: c.links,
}));

// Nav scoped to this page — in-page anchors stay on /en/ux-design-skill/.
const navLinks = [
  { label: 'Pricing', href: '/en/ux-design-skill/#cennik' },
  { label: 'Free UX Audit Skill', href: '/en/ux-design-skill/#audyt' },
  { label: 'Knowledge base', href: '/en/ux-design-skill/#baza-wiedzy' },
  { label: 'How it works', href: '/en/ux-design-skill/how-it-works' },
];
const navCtaHref = '/en/ux-design-skill/#cennik';
---

<BaseLayout
  title="UX Design Skill: UX process from brief to wireframe | Creative Sparks"
  description="A UX skill for Claude Code that takes your site from brief to wireframe. 92 knowledge files, 16 page types, 13 UX frameworks. One-time license, no subscription."
  ogTitle="Plan your site structure and content before you open Figma"
  ogDescription="UX Design Skill walks you from brief to a finished wireframe with real copy. Packages from $189."
  ogImage="/uxd-share.jpg"
>
  <TopAppBar navLinks={navLinks} ctaHref={navCtaHref} />
  <main>
    <HeroSection entryId="skill-lp" />
    <ProcessSection
      id="dowod"
      headingId="proof-gallery-heading"
      badge={proofEntry.data.badge}
      heading={proofEntry.data.heading}
      lead={proofEntry.data.lead}
      cards={proofCards}
      icon={proofIcon}
    >
      <script is:inline async src="https://fast.wistia.com/player.js"></script>
      <script is:inline async type="module" src="https://fast.wistia.com/embed/1siqhsesz9.js"></script>
      <div class="flex justify-start">
        <wistia-player
          media-id="1siqhsesz9"
          popover-content="link"
          wistia-popover="true"
          aspect="1.7777777777777777"
          style="display: inline-block;"
        >
          <a href="#" class="inline-flex items-center gap-2 tracking-tight transition-all duration-300 bg-white text-primary border-2 border-primary hover:bg-primary hover:text-white px-10 py-4 text-base font-extrabold">
            Watch the skill in action
            <span class="material-symbols-outlined text-lg" aria-hidden="true">play_arrow</span>
          </a>
        </wistia-player>
      </div>
    </ProcessSection>
    <UseCasesSection
      id="value-props"
      headingId="value-props-heading"
      badge="Value"
      heading={valuePropsEntry.data.heading}
      cases={valuePropsCases}
      icon={valuePropsIcon}
      groupName="value-props"
    />
    <ProcessSection
      id="proces"
      headingId="process-heading"
      badge="How it works"
      heading="Four steps from brief<br/>to a finished wireframe with real copy"
      cards={processCards}
      videoTile={{ mediaId: '1siqhsesz9', label: 'Video', title: 'See the UX Design Skill in action' }}
      icon={processIcon}
    />
    <KnowledgeBaseSection
      id="baza-wiedzy"
      heading="This skill understands UX design through built-in processes and a UX knowledge base."
      mapLabel="The skill's knowledge map"
    />
    <LandscapeSection id="darmowe-skille" entryId="skill-lp" />
    <ComparisonSection id="porownanie" entryId="skill-lp" />
    <ProblemsSection
      id="granice"
      headingId="boundaries-heading"
      badge={boundariesEntry.data.badge}
      heading="What this skill doesn't do"
      items={boundariesEntry.data.items}
      columns={3}
      icon={boundariesIcon}
      class="!bg-surface"
    />
    <PricingSection />
    <DemoSection
      id="audyt"
      badge={freeTrialEntry.data.badge}
      heading="Get the free UX audit skill and run it on your own site"
      intro={freeTrialEntry.data.intro}
      stages={freeTrialEntry.data.stages}
      note={freeTrialEntry.data.note}
      videoPopover={{ mediaId: '95i42fdxo8', label: 'Watch the video' }}
      icon={freeTrialIcon}
    >
      <FreeSkillForm slot="cta" surface="ux_design_skill_audyt" />
    </DemoSection>
    <ArchitectureSection />
    <PlatformSection />
    <ProblemsSection
      headingId="install-heading"
      badge={installEntry.data.badge}
      heading={installEntry.data.heading}
      intro={installEntry.data.intro}
      items={installEntry.data.items}
      columns={3}
      footerNote={installEntry.data.footerNote}
      footerLink={installEntry.data.footerLink}
      icon={installIcon}
    />
    <FAQSection />
    <AuthorSection />
    <DemoSection
      heading={finalCtaEntry.data.heading}
      intro={finalCtaEntry.data.intro}
      cta={finalCtaEntry.data.cta}
      secondaryLinks={finalCtaEntry.data.secondaryLinks}
      icon={finalCtaIcon}
    />
  </main>
  <Footer />
</BaseLayout>
