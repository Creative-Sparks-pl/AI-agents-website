---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopAppBar from '../../../components/sections/top-app-bar/TopAppBar.astro';
import Footer from '../../../components/sections/footer/Footer.astro';
import KBHero from '../../../components/sections/kb/KBHero.astro';
import KBPageTypes from '../../../components/sections/kb/KBPageTypes.astro';
import KBFrameworks from '../../../components/sections/kb/KBFrameworks.astro';
import KBPatterns from '../../../components/sections/kb/KBPatterns.astro';
import KBSources from '../../../components/sections/kb/KBSources.astro';
---

<BaseLayout
  title="Knowledge base: 92 files, 16 page types, 13 frameworks | UX Design Skill"
  description="The full UX knowledge base built into the skill. 16 page types, 13 decision frameworks, 100+ section patterns. Every recommendation grounded in verified sources."
  viewContent={{ content_name: 'knowledge_base' }}
>
  <TopAppBar
    navLinks={[
      { label: 'Page types', href: '#typy-stron' },
      { label: 'Frameworks', href: '#frameworki' },
      { label: 'Patterns', href: '#wzorce' },
      { label: 'Sources', href: '#zrodla' },
    ]}
    ctaLabel="Back to home"
    ctaHref="/en/ux-design-skill"
  />
  <main>
    <KBHero />
    <KBPageTypes />
    <KBFrameworks />
    <KBPatterns />
    <KBSources />
  </main>
  <Footer />
</BaseLayout>
