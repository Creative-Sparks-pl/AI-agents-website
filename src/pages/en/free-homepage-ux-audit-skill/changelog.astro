---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopAppBar from '../../../components/sections/top-app-bar/TopAppBar.astro';
import Footer from '../../../components/sections/footer/Footer.astro';
import ChangelogSection from '../../../components/sections/changelog/ChangelogSection.astro';

// The same top bar as the skill's landing page in this language: its three links, no buy button, not sticky.
const navLinks: { label: string; href: string }[] = [
  { label: 'UX Design Skill', href: '/en/ux-design-skill/' },
  { label: 'Reviews', href: '/en/free-homepage-ux-audit-skill/#reviews' },
  { label: 'How it works', href: '/en/ux-design-skill/how-it-works/' },
];
---

<BaseLayout
  title="Changelog: release notes | Homepage UX Audit Skill"
  description="Release notes for Homepage UX Audit Skill, the free skill that audits your homepage's UX. What changed in each version, from v1.0."
>
  <TopAppBar navLinks={navLinks} showCta={false} sticky={false} />
  <main>
    <ChangelogSection product="homepage-ux-audit" label="Homepage UX Audit Skill" />
  </main>
  <Footer changelogHref="/en/free-homepage-ux-audit-skill/changelog/" />
</BaseLayout>
