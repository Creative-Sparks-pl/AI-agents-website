const sections = rawSections.map((s, i) => ({
  ...s,
  groupStarts: !!s.group && (i === 0 || s.group !== rawSections[i - 1].group),
}));

// The same top bar as the free skills' pages: three links, no buy button, not sticky.
const navLinks: { label: string; href: string }[] = [
  { label: 'UX Design Skill', href: '/ux-design-skill/' },
  { label: 'Opinie', href: '/free-website-planning-skill/#opinie' },
  { label: 'Jak pracować', href: '/free-skills/guide/' },
];
---

<BaseLayout
  title="Jak pracować z darmowymi skillami: instrukcja | Creative Sparks"
  description="Instrukcja do Skilla do planowania stron i Skilla do audytu UX strony głównej: instalacja, pierwsza sesja, praca ze skillem i wyniki."
>
  <TopAppBar navLinks={navLinks} showCta={false} sticky={false} />
  <main>
    <section class="py-20 md:py-28 px-6 bg-surface-primary">
      <div class="max-w-screen-2xl mx-auto">
        <SectionWithIcon icon={sectionIcon}>
          <Fragment slot="header">
            <span class="font-label text-primary text-sm mb-4">Darmowe skille</span>
            <h1 class="font-headline font-bold text-4xl md:text-5xl tracking-tight leading-[1.1] text-foreground">
              Jak pracować z darmowymi skillami
            </h1>
            <p class="text-muted text-lg leading-relaxed mt-6 max-w-3xl">
              Ta instrukcja dotyczy obu darmowych skilli:
              <a href="/free-website-planning-skill/" class="text-primary underline underline-offset-4 hover:no-underline">Skilla do planowania stron</a>
              i
              <a href="/free-homepage-ux-audit-skill/" class="text-primary underline underline-offset-4 hover:no-underline">Skilla do audytu UX strony głównej</a>.
              Pracuje się z nimi tak samo. Pierwszy planuje nową stronę, drugi sprawdza stronę główną, którą już masz.
            </p>
          </Fragment>

          <div class="flex flex-col">
            {sections.map((section) => (
              <>
                {section.groupStarts && (
                  <h2 class="font-headline font-bold text-4xl md:text-5xl tracking-tight leading-[1.1] text-foreground mt-20 mb-8">
                    {section.group}
                  </h2>
                )}
                <details
                  id={section.id}
                  class="group border-b border-border/30 overflow-hidden bg-white"
                  name="guide"
                  open={false}
                >
                  <summary class="flex items-start justify-between p-6 md:p-10 cursor-pointer list-none hover:bg-surface-hover transition-colors">
                    <div class="flex flex-col md:flex-row gap-4 md:gap-12 flex-1 md:items-start">
                      <span class="font-label text-xs font-bold text-muted w-16 hidden sm:block leading-[1.4]">
                        {section.number}
                      </span>
                      <div class="flex flex-col gap-3 flex-1">
                        <span class="font-label text-sm text-primary leading-none">{section.label}</span>
                        <h2 class="font-headline font-bold text-2xl md:text-3xl tracking-tight leading-tight text-foreground">
                          {section.title}
                        </h2>
                      </div>
                    </div>
                    <span class="material-symbols-outlined text-muted expand-icon transition-transform duration-300 pt-2" aria-hidden="true">expand_more</span>
                  </summary>
                  <div class="px-6 pb-12 md:pb-16 md:pl-[152px] md:pr-10">
                    <div class="max-w-3xl">
                      {section.description && (
                        <p class="text-muted text-lg leading-relaxed mb-6">
                          {section.description}
                        </p>
                      )}
                      {section.bullets.length > 0 && (
                        <ul class="space-y-3 mb-8">
                          {section.bullets.map((bullet) => (
                            <li class="flex items-start gap-3 text-base text-muted">
                              {!bullet.startsWith('<span class="material-symbols-outlined') && (
                                <svg class="w-5 h-5 shrink-0 mt-0.5" viewBox="0 0 19 22" fill="none"><path d="M14.32 12.84L10.24 17.66L8.75 16.77L12.11 12.67L8.75 8.57L10.24 7.7L14.32 12.53V12.84ZM9.54 12.84L5.49 17.66L4 16.77L7.36 12.67L4 8.57L5.49 7.7L9.54 12.53V12.84Z" fill="currentColor" class="text-primary"/></svg>
                              )}
                              <span class="[&_strong]:text-foreground [&_strong]:font-semibold [&_code]:font-label [&_code]:text-sm [&_code]:bg-surface-primary [&_code]:px-1" set:html={bullet} />
                            </li>
                          ))}
                        </ul>
                      )}
                      {section.groups && section.groups.map((group) => (
                        <div class="mb-8">
                          <h3 class="font-headline font-bold text-lg text-foreground mb-3">{group.heading}</h3>
                          <ul class="space-y-3">
                            {group.bullets.map((bullet) => (
                              <li class="flex items-start gap-3 text-base text-muted">
                                <svg class="w-5 h-5 shrink-0 mt-0.5" viewBox="0 0 19 22" fill="none"><path d="M14.32 12.84L10.24 17.66L8.75 16.77L12.11 12.67L8.75 8.57L10.24 7.7L14.32 12.53V12.84ZM9.54 12.84L5.49 17.66L4 16.77L7.36 12.67L4 8.57L5.49 7.7L9.54 12.53V12.84Z" fill="currentColor" class="text-primary"/></svg>
                                <span class="[&_strong]:text-foreground [&_strong]:font-semibold [&_code]:font-label [&_code]:text-sm [&_code]:bg-surface-primary [&_code]:px-1" set:html={bullet} />
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                      {section.links.length > 0 && (
                        <div class="bg-surface-primary p-6 space-y-4 rounded-xl">
                          <div class="flex flex-wrap gap-x-12 gap-y-3">
                            {section.links.map((link) => (
                              <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary font-label font-bold text-sm tracking-tight hover:translate-x-1 transition-transform">
                                <span class="material-symbols-outlined text-sm" data-icon={link.icon} aria-hidden="true">{link.icon}</span>
                                {link.label}
                                <span class="material-symbols-outlined text-sm" data-icon="trending_flat" aria-hidden="true">trending_flat</span>
                              </a>
                            ))}
                          </div>
                          {section.quote && <p class="text-sm font-label text-muted">{section.quote}</p>}
                        </div>
                      )}
                    </div>
                  </div>
                </details>
              </>
            ))}
          </div>
        </SectionWithIcon>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // An address with a section's id opens that section: the sign-up overlay and the emails link to #no-ai-tool.
  function openLinkedSection() {
    let id = '';
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    if (!id) return;
    const section = document.getElementById(id);
    if (!(section instanceof HTMLDetailsElement)) return;
    section.open = true;
    section.scrollIntoView({ block: 'start' });
  }
  openLinkedSection();
  window.addEventListener('hashchange', openLinkedSection);
</script>

<style>
  details[open] summary .expand-icon {
    transform: rotate(180deg);
  }

  details[open] summary:hover {
    background-color: transparent;
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>
