    bullets: [],
    groups: [
      {
        heading: 'Co możesz zgłosić',
        bullets: [
          '<strong>Pytanie</strong> — „jak zrobić X?”, „co to znaczy Y?”, „dlaczego skill…?”. Skill uporządkuje pytanie z kontekstem i prześle.',
