    links: [
      { label: 'Przykładowy plan strony', href: '/examples/website-planning-skill_project_plan.html', icon: 'description' },
      { label: 'Przykładowy audyt strony głównej', href: '/examples/creativesparks-ux-designer_audit.html', icon: 'description' },
