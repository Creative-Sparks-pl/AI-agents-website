---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopAppBar from '../../components/sections/top-app-bar/TopAppBar.astro';
import Footer from '../../components/sections/footer/Footer.astro';
import SectionWithIcon from '../../components/ui/SectionWithIcon.astro';
import sectionIcon from '../../assets/icons/shape-3.svg';

// The guide for both free skills, made from the paid skill's guide (src/pages/ux-design-skill/instrukcja.astro).
// The English page has the same address under /en/, so the two pair up as language versions.
// #no-ai-tool is linked from the sign-up overlay and the emails: keep the id as it is.

interface GuideLink {
  label: string;
  href: string;
  icon: string;
}

interface GuideSection {
  id?: string;
  number: string;
  label: string;
  title: string;
  description: string;
  bullets: string[];
  groups?: { heading: string; bullets: string[] }[];
  links: GuideLink[];
  quote: string;
  group: string | null;
}

const rawSections: GuideSection[] = [
  {
    number: 'Esencja',
    label: 'Główne zasady',
    title: 'Główne zasady współpracy',
    description: 'Krótka lista zasad, które decydują o jakości wyniku. Każda jest rozwinięta w sekcjach poniżej.',
    bullets: [
      '<strong>Więcej kontekstu = mniej zgadywania.</strong> Im więcej dasz, tym lepszy wynik. Ale wystarczy też minimum: jedno zdanie o stronie albo jej adres.',
      '<strong>Decyzja po Twojej stronie.</strong> Skill pokazuje opcje z trade-offami albo wnioski z poziomem pewności. Ty wybierasz, co z nimi zrobić.',
      '<strong>Sprawdzaj oznaczenia pewności.</strong> 🟢 zielone zostaw, 🟡 żółte zweryfikuj, 🔴 czerwone uzupełnij, zanim ruszysz dalej.',
      '<strong>Kwestionuj wyniki.</strong> Pytaj „dlaczego”, proś o alternatywy, każ skracać.',
      '<strong>Skill to też konsultant.</strong> Pytaj o metodologię, proś o weryfikację Twoich decyzji.',
      '<strong>Plik = pamięć projektu.</strong> Skill zapisuje wynik w pliku HTML, a nie w pamięci rozmowy.',
      '<strong>Nie wiesz jak? Zapytaj skill.</strong> Zna swój proces i podpowie następny krok. Nie musisz domyślać się sam.',
    ],
    links: [],
    quote: '',
    group: null,
  },
  {
    number: 'Setup',
    label: 'Konfiguracja',
    title: 'Jak zainstalować skill',
    description: 'Po zapisie dostajesz maila z osobistym linkiem do instalacji. Wklejasz instrukcję z tego maila (link i zdanie pod nim) do Claude Code, Codex albo Cursora, a agent sam instaluje skill. Nie masz jeszcze żadnego z tych narzędzi? Zobacz „Nie masz jeszcze narzędzia AI?” poniżej.',
    bullets: [],
    groups: [
      {
        heading: 'Instalacja z osobistego linku',
        bullets: [
          '<strong>Otwórz maila z linkiem na komputerze.</strong> Przychodzi z adresu tomasz@creativesparks.pl w ciągu minuty od zapisu. Nie widzisz go? Sprawdź folder Spam.',
          '<strong>Wklej instrukcję z maila do Claude Code, Codex albo Cursora.</strong> W mailu jest Twój link i zdanie pod nim. Skopiuj oba wiersze, niczego nie zmieniając.',
          '<strong>Agent pokaże plan i zapyta, zanim cokolwiek skopiuje.</strong> Może kilka razy poprosić o zgodę na uruchomienie poleceń (pobranie, rozpakowanie, kopiowanie i sprawdzenie plików). To normalne.',
          '<strong>Po instalacji uruchom skill jego komendą:</strong> <code>/website-planning</code> albo <code>/homepage-ux-audit</code> w Claude Code i Cursorze, <code>$website-planning</code> albo <code>$homepage-ux-audit</code> w Codexie. Komendę znajdziesz też w mailu.',
          '<strong>Każdy darmowy skill dostajesz raz na adres email.</strong> Masz go już? Twój link jest w pierwszym mailu.',
        ],
      },
      {
        heading: 'Za darmo, jeśli zainstalujesz go w ciągu 14 dni',
        bullets: [
          '<strong>Zainstaluj skill w ciągu 14 dni od zapisu.</strong> Wtedy zostaje darmowy, a projekt może poczekać: korzystasz ze skilla, kiedy chcesz.',
          '<strong>Po instalacji link działa dalej.</strong> Możesz z niego instalować ponownie, więc zachowaj tego maila. Nie udostępniaj linku innym osobom.',
          '<strong>Bez instalacji w ciągu 14 dni link nie da już pakietu.</strong> Później nie pobierzesz już z niego skilla.',
        ],
      },
      {
        heading: 'Aktualizacje',
        bullets: [
