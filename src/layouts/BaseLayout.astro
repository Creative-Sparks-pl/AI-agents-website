---
import '../styles/global.css';
import { localeFromPathname, locales, pathForLocale, defaultLocale } from '../lib/i18n';

interface ViewContentParams {
  content_name: string;
  content_category?: string;
}

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonical?: string;
  viewContent?: ViewContentParams;
}

const {
  title,
  description = 'Narzędzie do planowania stron z ekspertyzą specjalisty UX, wspierane przez AI. Sprawdzony proces od briefu do wireframe\'u. 92 pliki wiedzy, 16 typów stron, 14 obszarów. Jednorazowy zakup.',
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og-image.jpg',
  canonical,
  viewContent,
} = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site).toString();

// hreflang alternates — one per locale + x-default pointing at PL.
const hreflangs = locales.map((loc) => {
  const tag = loc === 'pl' ? 'pl-PL' : 'en-US';
  const path = pathForLocale(Astro.url.pathname, loc);
  return { tag, href: new URL(path, Astro.site).toString() };
});
const xDefaultHref = new URL(pathForLocale(Astro.url.pathname, defaultLocale), Astro.site).toString();

const ogLocale = locale === 'en' ? 'en_US' : 'pl_PL';

const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <!-- Cookiebot CMP — must load first to gate downstream scripts -->
    <script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="068aceee-c3db-442f-acf0-4310125da547" data-blockingmode="auto" type="text/javascript"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#010DFF" />
    <meta name="facebook-domain-verification" content="9fop3dqjfca9ozxfjfqfibp6o69s3o" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.toString()} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- hreflang alternates -->
    {hreflangs.map(({ tag, href }) => (
      <link rel="alternate" hreflang={tag} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Asystent UX",
        "description": "Narzędzie do planowania stron z ekspertyzą specjalisty UX, wspierane przez AI. Sprawdzony proces od briefu do wireframe'u. 92 pliki wiedzy, 16 typów stron, 14 obszarów. Jednorazowy zakup.",
        "applicationCategory": "DesignApplication",
        "operatingSystem": "Web",
        "offers": [
          {
            "@type": "Offer",
            "name": "Solo",
            "price": "799",
            "priceCurrency": "PLN",
            "description": "1 użytkownik"
          },
          {
            "@type": "Offer",
            "name": "Studio",
            "price": "1499",
            "priceCurrency": "PLN",
            "description": "Do 5 użytkowników"
          },
          {
            "@type": "Offer",
            "name": "Agencja",
            "price": "2999",
            "priceCurrency": "PLN",
            "description": "Bez limitu użytkowników"
          }
        ],
        "author": {
          "@type": "Person",
          "name": "Tomasz Maciąg",
          "jobTitle": "Founder",
          "worksFor": {
            "@type": "Organization",
            "name": "Fuse Collective"
          }
        }
      }
    </script>

    <!-- Umami Analytics -->
    <script defer src="https://analytics.creativesparks.pl/script.js" data-website-id="37a76f9d-7246-4d45-b832-3b35e78eee08"></script>

    {metaPixelId && (
      <Fragment>
        <!-- Meta Pixel (gated by Cookiebot marketing consent) -->
        <script type="text/plain" data-cookieconsent="marketing" set:html={`
!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${metaPixelId}');
fbq('track', 'PageView');
        `} />
        <noscript>
          <img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`} alt="" />
        </noscript>
      </Fragment>
    )}

    <!-- Conversion tracking helper: fires fbq + CAPI on [data-track] click, post-consent -->
    <script is:inline>
      (function () {
        function hasMarketingConsent() {
          return typeof window.Cookiebot !== 'undefined'
            && window.Cookiebot.consent
            && window.Cookiebot.consent.marketing === true;
        }

        function newEventId() {
          if (window.crypto && typeof window.crypto.randomUUID === 'function') {
            return window.crypto.randomUUID();
          }
          return Date.now() + '-' + Math.random().toString(36).slice(2);
        }

        function readTestEventCode() {
          try {
            var fromUrl = new URLSearchParams(window.location.search).get('test_event_code');
            if (fromUrl) {
              sessionStorage.setItem('meta_test_event_code', fromUrl);
              return fromUrl;
            }
            return sessionStorage.getItem('meta_test_event_code') || undefined;
          } catch (_e) {
            return undefined;
          }
        }

        window.trackConversion = function (eventName, params) {
          params = params || {};
          if (!hasMarketingConsent()) return;
          var eventId = newEventId();
          if (typeof window.fbq === 'function') {
            window.fbq('track', eventName, params, { eventID: eventId });
          }
          var testEventCode = readTestEventCode();
          var bodyObj = {
            event_name: eventName,
            event_id: eventId,
            custom_data: params,
            source_url: window.location.href,
          };
          if (testEventCode) bodyObj.test_event_code = testEventCode;
          var body = JSON.stringify(bodyObj);
          try {
            if (navigator.sendBeacon) {
              navigator.sendBeacon('/api/meta-capi', new Blob([body], { type: 'application/json' }));
            } else {
              fetch('/api/meta-capi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: body,
                keepalive: true,
              });
            }
          } catch (_e) { /* no-op */ }
        };

        document.addEventListener('click', function (e) {
          var el = e.target.closest && e.target.closest('[data-track]');
          if (!el) return;
          var eventName = el.getAttribute('data-track');
          if (!eventName) return;
          var params = {};
          for (var i = 0; i < el.attributes.length; i++) {
            var attr = el.attributes[i];
            if (attr.name.indexOf('data-track-') === 0) {
              params[attr.name.slice('data-track-'.length)] = attr.value;
            }
          }
          window.trackConversion(eventName, params);
        });

        // Queue conversions that need to fire on page load. Cookiebot may load
        // after this script and may not yet have a consent decision — wait for
        // CookiebotOnConsentReady (initial decision) and CookiebotOnAccept (user accepts later).
        window.queueConversion = function (eventName, params) {
          var fired = false;
          function tryFire() {
            if (fired) return;
            if (!hasMarketingConsent()) return;
            fired = true;
            window.trackConversion(eventName, params);
          }
          tryFire();
          document.addEventListener('CookiebotOnConsentReady', tryFire);
          document.addEventListener('CookiebotOnAccept', tryFire);
        };
      })();
    </script>

    {viewContent && (
      <script is:inline define:vars={{ viewContentParams: viewContent }}>
        if (typeof window.queueConversion === 'function') {
          window.queueConversion('ViewContent', viewContentParams);
        }
      </script>
    )}
  </head>
  <body class="bg-background text-foreground">
    <slot />
  </body>
</html>
