---
import '../styles/global.css';
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import '../styles/cookieconsent-theme.css';
import { getEntry } from 'astro:content';
import { localeFromPathname, locales, pathForLocale, defaultLocale } from '../lib/i18n';
import { buildConsentConfig, CONSENT_COOKIE_NAME, CONSENT_REVISION } from '../lib/consent-config';
import gilroyBoldUrl from '../assets/fonts/Radomir-Tinkov---Gilroy-Bold.woff2?url';

interface ViewContentParams {
  content_name: string;
  content_category?: string;
}

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonical?: string;
  viewContent?: ViewContentParams;
  /** Loads PostHog recordings + heatmaps after statistics consent. Landing pages only. */
  posthog?: boolean;
}

const locale = localeFromPathname(Astro.url.pathname);

const DEFAULT_DESCRIPTION_PL = 'Narzędzie do planowania stron z ekspertyzą specjalisty UX, wspierane przez AI. Sprawdzony proces od briefu do wireframe\'u. 110 plików wiedzy, 16 typów stron, 19 tematów ogólnych. Jednorazowy zakup.';
const DEFAULT_DESCRIPTION_EN = 'A UX skill for Claude Code that takes your site from brief to wireframe. 110 knowledge files, 16 page types, 13 UX frameworks. One-time license, no subscription.';

const {
  title,
  description = locale === 'en' ? DEFAULT_DESCRIPTION_EN : DEFAULT_DESCRIPTION_PL,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og-image.jpg',
  canonical,
  viewContent,
  posthog = false,
} = Astro.props;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site).toString();

// hreflang alternates — one per locale + x-default pointing at PL.
const hreflangs = locales.map((loc) => {
  const tag = loc === 'pl' ? 'pl-PL' : 'en-US';
  const path = pathForLocale(Astro.url.pathname, loc);
  return { tag, href: new URL(path, Astro.site).toString() };
});
const xDefaultHref = new URL(pathForLocale(Astro.url.pathname, defaultLocale), Astro.site).toString();

const ogLocale = locale === 'en' ? 'en_US' : 'pl_PL';

// JSON-LD product structured data — locale-aware product name + tier descriptions + USD/PLN pricing.
const productStructuredData = locale === 'en'
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'UX Design Skill',
      description: DEFAULT_DESCRIPTION_EN,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'Web',
      offers: [
        { '@type': 'Offer', name: 'Solo', price: '379', priceCurrency: 'USD', description: '1 user' },
        { '@type': 'Offer', name: 'Studio', price: '679', priceCurrency: 'USD', description: 'Up to 5 users' },
        { '@type': 'Offer', name: 'Agency', price: '1499', priceCurrency: 'USD', description: 'Unlimited users' },
      ],
      author: {
        '@type': 'Person',
        name: 'Tomasz Maciąg',
        jobTitle: 'Founder',
        worksFor: { '@type': 'Organization', name: 'Fuse Collective' },
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'UX Design Skill',
      description: DEFAULT_DESCRIPTION_PL,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'Web',
      offers: [
        { '@type': 'Offer', name: 'Solo', price: '1299', priceCurrency: 'PLN', description: '1 użytkownik' },
        { '@type': 'Offer', name: 'Studio', price: '2499', priceCurrency: 'PLN', description: 'Do 5 użytkowników' },
        { '@type': 'Offer', name: 'Agencja', price: '4999', priceCurrency: 'PLN', description: 'Bez limitu użytkowników' },
      ],
      author: {
        '@type': 'Person',
        name: 'Tomasz Maciąg',
        jobTitle: 'Founder',
        worksFor: { '@type': 'Organization', name: 'Fuse Collective' },
      },
    };

const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined;

// PostHog Cloud EU. The project key is public by design, like Umami's website ID.
const POSTHOG_PROJECT_KEY = 'phc_xJEvm2rFYcD3VKe3BQb2zPpAaWqVZRe7zBqYUwhsgG5t';
const POSTHOG_API_HOST = 'https://eu.i.posthog.com';

// Cookie banner configuration for this page's language, built from src/content/consent/.
// `<` is escaped so the JSON can never close its <script> element.
const consentContent = await getEntry('consent', locale);
if (!consentContent) throw new Error(`Missing consent content for locale "${locale}"`);
const consentConfigJson = JSON.stringify(buildConsentConfig(consentContent.data, locale)).replace(/</g, '\\u003c');

// What each category stores in the browser, so refusing or withdrawing a category can clear it.
const consentStorage: Record<string, { name: string; kind: string }[]> = { necessary: [], statistics: [], marketing: [] };
for (const entry of consentContent.data.cookies) {
  const items = consentStorage[entry.category];
  if (items) items.push(...entry.storage.map(({ name, kind }) => ({ name, kind })));
}
const consentStorageJson = JSON.stringify(consentStorage).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Wistia tracks only with statistics consent. This runs before any player script, so a
         player that loads with the page follows the stored choice. Without it, privacy mode keeps
         the player from storing a viewer ID, doNotTrack stops its anonymous play statistics, and
         wistiaDisableMux stops the playback-quality reports it sends to Mux Data for 1 play in 10. -->
    <script is:inline define:vars={{ consentCookieName: CONSENT_COOKIE_NAME, consentRevision: CONSENT_REVISION }}>
      var wistiaAllowed = false;
      try {
        var pair = document.cookie.split('; ').find(function (item) { return item.indexOf(consentCookieName + '=') === 0; });
        if (pair) {
          var stored = JSON.parse(decodeURIComponent(pair.slice(consentCookieName.length + 1)));
          wistiaAllowed = stored.revision === consentRevision && stored.categories.indexOf('statistics') !== -1;
        }
      } catch (_e) { /* a missing or malformed choice means no consent */ }
      (window._wq = window._wq || []).push(function (W) { W.consent(wistiaAllowed); });
      if (!wistiaAllowed) {
        window.wistiaOptions = { _all: { doNotTrack: true } };
        window.wistiaDisableMux = true;
      }
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#010DFF" />
    <meta name="facebook-domain-verification" content="9fop3dqjfca9ozxfjfqfibp6o69s3o" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.toString()} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- hreflang alternates -->
    {hreflangs.map(({ tag, href }) => (
      <link rel="alternate" hreflang={tag} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Material Symbols still hosted by Google Fonts (subset to 28 icons). Noto Sans + Mono are now self-hosted via @fontsource — see global.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Wistia preconnect — player scripts load on click, but warming the connection saves ~360 ms at first play -->
    <link rel="preconnect" href="https://fast.wistia.net" crossorigin />
    <!-- Preload Gilroy Bold — the LCP element is the hero <h1> in Gilroy. Preloading it before paint kills the font-swap LCP-shift. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={gilroyBoldUrl} />
    <!-- Material Symbols subset — request only the 47 icons used across the public pages. When adding a new icon, append it to icon_names alphabetically. -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&icon_names=account_balance,account_tree,arrow_forward,article,auto_awesome,biotech,block,bolt,category,check,check_circle,chevron_right,close,code,description,download,drive_folder_upload,edit_note,expand_more,fact_check,folder,folder_open,format_quote,forum,horizontal_rule,info,keyboard_arrow_down,layers,mail,menu_book,pause,payments,play_arrow,psychology,public,save,schedule,search,shopping_cart,signal_cellular_alt,star,sync,task_alt,terminal,trending_flat,troubleshoot,verified&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(productStructuredData)} />

    <!-- Umami Analytics (cookieless, outside the banner) -->
    <script defer src="https://analytics.creativesparks.pl/script.js" data-website-id="37a76f9d-7246-4d45-b832-3b35e78eee08"></script>
    <!-- Umami events from data-umami-seen, data-umami-click and data-umami-interest attributes (bundled, sends through window.umami) -->
    <script>
      import '../scripts/umami-attributes';
    </script>

    <!-- Cookie banner (CookieConsent v3, self-hosted). Gates scripts tagged type="text/plain" data-category="…". -->
    <script type="application/json" id="consent-config" set:html={consentConfigJson} />
    <script type="application/json" id="consent-storage" set:html={consentStorageJson} />
    <script>
      import '../scripts/consent';
    </script>

    {metaPixelId && (
      <Fragment>
        <!-- Meta Pixel (runs only after marketing consent in the cookie banner).
             Init only — the deduplicated PageView fires via queueConversion below
             so Pixel + CAPI share an event_id and Meta dedupes correctly. -->
        <script type="text/plain" data-category="marketing" data-service="meta-pixel" set:html={`
!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${metaPixelId}');
        `} />
      </Fragment>
    )}

    {posthog && (
      <Fragment>
        <!-- PostHog session recordings + heatmaps (runs only after statistics consent in the cookie banner).
             Official posthog-js stub; init waits for the load event so page-speed scores stay unchanged.
             No autocapture, surveys, console logs or performance events; every input is masked in recordings. -->
        <script type="text/plain" data-category="statistics" data-service="posthog" set:html={`
!function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}p||((p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",p.onerror=function(){p=null},(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r));var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
(function () {
  function initPostHog() {
    posthog.init('${POSTHOG_PROJECT_KEY}', {
      api_host: '${POSTHOG_API_HOST}',
      defaults: '2026-08-30',
      autocapture: false,
      capture_pageview: true,
      capture_pageleave: true,
      capture_heatmaps: true,
      disable_session_recording: false,
      session_recording: { maskAllInputs: true },
      enable_recording_console_log: false,
      capture_performance: false,
      capture_exceptions: false,
      disable_surveys: true,
    });
  }
  if (document.readyState === 'complete') initPostHog();
  else window.addEventListener('load', initPostHog);
})();
        `} />
      </Fragment>
    )}

    <!-- Conversion tracking helper: fires fbq + CAPI on [data-track] click, post-consent -->
    <script is:inline>
      (function () {
        // The cookie banner (src/scripts/consent.ts) exposes CookieConsent once it has run.
        function hasMarketingConsent() {
          return typeof window.CookieConsent !== 'undefined'
            && window.CookieConsent.acceptedCategory('marketing') === true;
        }

        function newEventId() {
          if (window.crypto && typeof window.crypto.randomUUID === 'function') {
            return window.crypto.randomUUID();
          }
          return Date.now() + '-' + Math.random().toString(36).slice(2);
        }

        function readTestEventCode() {
          try {
            var fromUrl = new URLSearchParams(window.location.search).get('test_event_code');
            if (fromUrl) {
              sessionStorage.setItem('meta_test_event_code', fromUrl);
              return fromUrl;
            }
            return sessionStorage.getItem('meta_test_event_code') || undefined;
          } catch (_e) {
            return undefined;
          }
        }

        // Meta matches a conversion to an ad click more often with the visitor's email. Only the
        // SHA-256 hash of the trimmed, lowercased address leaves the browser, never the address itself.
        // Resolves to undefined when hashing is unavailable, so the event is still sent without it.
        function hashEmail(email) {
          try {
            var normalized = String(email || '').trim().toLowerCase();
            if (!normalized || !window.crypto || !window.crypto.subtle || typeof TextEncoder === 'undefined') {
              return Promise.resolve(undefined);
            }
            return window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(normalized)).then(function (buf) {
              return Array.prototype.map.call(new Uint8Array(buf), function (b) {
                return ('0' + b.toString(16)).slice(-2);
              }).join('');
            }, function () { return undefined; });
          } catch (_e) {
            return Promise.resolve(undefined);
          }
        }

        function sendCapi(bodyObj) {
          var body = JSON.stringify(bodyObj);
          try {
            if (navigator.sendBeacon) {
              navigator.sendBeacon('/api/meta-capi', new Blob([body], { type: 'application/json' }));
            } else {
              fetch('/api/meta-capi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: body,
                keepalive: true,
              });
            }
          } catch (_e) { /* no-op */ }
        }

        // `user` is optional: { email } adds the hashed email to the server-side event.
        window.trackConversion = function (eventName, params, user) {
          params = params || {};
          if (!hasMarketingConsent()) return;
          var eventId = newEventId();
          if (typeof window.fbq === 'function') {
            window.fbq('track', eventName, params, { eventID: eventId });
          }
          var testEventCode = readTestEventCode();
          var bodyObj = {
            event_name: eventName,
            event_id: eventId,
            custom_data: params,
            source_url: window.location.href,
          };
          if (testEventCode) bodyObj.test_event_code = testEventCode;
          if (user && user.email) {
            hashEmail(user.email).then(function (em) {
              if (em) bodyObj.em = em;
              sendCapi(bodyObj);
            });
          } else {
            sendCapi(bodyObj);
          }
        };

        document.addEventListener('click', function (e) {
          var el = e.target.closest && e.target.closest('[data-track]');
          if (!el) return;
          var eventName = el.getAttribute('data-track');
          if (!eventName) return;
          var params = {};
          for (var i = 0; i < el.attributes.length; i++) {
            var attr = el.attributes[i];
            if (attr.name.indexOf('data-track-') === 0) {
              params[attr.name.slice('data-track-'.length)] = attr.value;
            }
          }
          window.trackConversion(eventName, params);
        });

        // Queue conversions that need to fire on page load. The banner script runs after this
        // one, so wait for its events on window: cc:onConsent (a stored or first choice) and
        // cc:onChange (a later change). The banner runs the tagged Pixel snippet before it
        // dispatches either, so fbq exists and the browser and server events share one ID.
        window.queueConversion = function (eventName, params) {
          var fired = false;
          function tryFire() {
            if (fired) return;
            if (!hasMarketingConsent()) return;
            fired = true;
            window.trackConversion(eventName, params);
          }
          tryFire();
          window.addEventListener('cc:onConsent', tryFire);
          window.addEventListener('cc:onChange', tryFire);
        };
      })();
    </script>

    {metaPixelId && (
      <script is:inline>
        // Deduplicated PageView — fires once per page load after consent.
        // Pixel + CAPI share an event_id so Meta dedupes both signals.
        if (typeof window.queueConversion === 'function') {
          window.queueConversion('PageView', {});
        }
      </script>
    )}

    {viewContent && (
      <script is:inline define:vars={{ viewContentParams: viewContent }}>
        if (typeof window.queueConversion === 'function') {
          window.queueConversion('ViewContent', viewContentParams);
        }
      </script>
    )}
  </head>
  <body class="bg-background text-foreground">
    <slot />
  </body>
</html>
