---
import type { HTMLAttributes } from 'astro/types';
import Logo from '../../../assets/logo.svg?raw';
import Button from '../../ui/Button.astro';
import { localeFromPathname, requireLocalizedEntry } from '../../../lib/i18n';

interface NavLink {
  label: string;
  href: string;
}

interface Props extends HTMLAttributes<'header'> {
  navLinks?: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
  showCta?: boolean;
  sticky?: boolean;
  class?: string;
}

const locale = localeFromPathname(Astro.url.pathname);
const entry = await requireLocalizedEntry('nav', locale);
const defaults = entry.data;

const {
  navLinks = defaults.links,
  ctaLabel = defaults.cta.label,
  ctaHref = defaults.cta.href,
  showCta = true,
  sticky = true,
  class: className,
  ...rest
} = Astro.props;
---

<header
  class:list={[
    'w-full z-50 bg-white/90 backdrop-blur-md border-b border-border/30',
    sticky && 'sticky top-0',
    className,
  ]}
  {...rest}
>
  <nav class="flex justify-between items-center max-w-screen-2xl mx-auto px-6 h-20" aria-label={locale === 'en' ? 'Main navigation' : 'Główna nawigacja'}>
    <a href={locale === 'en' ? '/en/ux-design-skill' : '/ux-design-skill'} class="text-primary block h-8 [&>svg]:h-full [&>svg]:w-auto" aria-label="Creative Sparks">
      <Fragment set:html={Logo} />
    </a>

    <div class="hidden md:flex items-center gap-10 font-normal font-label tracking-tight text-[13px]">
      {navLinks.map((link) => (
        <a href={link.href} class="text-foreground/70 hover:text-primary transition-colors">
          {link.label}
        </a>
      ))}
    </div>

    {showCta && (
      <Button href={ctaHref} size="sm" class="hidden sm:inline-flex" onclick="setTimeout(function(){window.umami&&window.umami.track('Nav CTA')},0)">
        {ctaLabel}
      </Button>
    )}
  </nav>
</header>
