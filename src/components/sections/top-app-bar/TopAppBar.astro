---
import type { HTMLAttributes } from 'astro/types';
import Logo from '../../../assets/logo.svg?raw';
import Button from '../../ui/Button.astro';
import PreSaleCountdown from '../../ui/PreSaleCountdown.astro';
import { localeFromPathname, requireLocalizedEntry } from '../../../lib/i18n';
import { isInSaleWindow } from '../../../lib/presale';

interface NavLink {
  label: string;
  href: string;
}

interface Props extends HTMLAttributes<'header'> {
  navLinks?: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
  showCta?: boolean;
  sticky?: boolean;
  class?: string;
}

const locale = localeFromPathname(Astro.url.pathname);
const entry = await requireLocalizedEntry('nav', locale);
const defaults = entry.data;

const {
  navLinks = defaults.links,
  ctaLabel = defaults.cta.label,
  ctaHref = defaults.cta.href,
  showCta = true,
  sticky = true,
  class: className,
  ...rest
} = Astro.props;

// During Black Friday the default CTA (to the paid skill's prices) swaps for a black-and-yellow sale button.
// A page with its own CTA keeps it. The sale-window script flips the pair at both edges of the window.
const showSaleCta = showCta && ctaHref === defaults.cta.href;
const saleCtaLabel = locale === 'en' ? 'Black Friday: 20% off' : 'Black Friday do −20%';
const inSale = isInSaleWindow(Date.now());
---

<header
  class:list={[
    'w-full z-50 bg-white/90 backdrop-blur-md border-b border-border/30',
    sticky && 'sticky top-0',
    className,
  ]}
  {...rest}
>
  <nav class="flex justify-between items-center max-w-screen-2xl mx-auto px-6 h-20" aria-label={locale === 'en' ? 'Main navigation' : 'Główna nawigacja'}>
    <a href={locale === 'en' ? '/en/ux-design-skill/' : '/ux-design-skill/'} class="text-primary block h-8 [&>svg]:h-full [&>svg]:w-auto" aria-label="Creative Sparks">
      <Fragment set:html={Logo} />
    </a>

    <div class="hidden md:flex items-center gap-4 lg:gap-10 font-normal font-label tracking-tight text-[13px]">
      {navLinks.map((link) => (
        <a href={link.href} class="text-foreground/70 hover:text-primary transition-colors" data-umami-click="Nav link" data-umami-click-link={link.href}>
          {link.label}
        </a>
      ))}
    </div>

    {showCta && (
      <Button
        href={ctaHref}
        size="sm"
        class="hidden sm:inline-flex"
        data-list-only={showSaleCta ? '' : undefined}
        style={showSaleCta && inSale ? 'display:none' : undefined}
        onclick="setTimeout(function(){window.umami&&window.umami.track('Nav CTA')},0)"
      >
        {ctaLabel}
      </Button>
    )}
    {showSaleCta && (
      <Fragment>
        <Button
          href={ctaHref}
          size="sm"
          variant="sale"
          class="hidden sm:inline-flex"
          data-sale-only
          style={inSale ? undefined : 'display:none'}
          onclick="setTimeout(function(){window.umami&&window.umami.track('Nav CTA')},0)"
        >
          {saleCtaLabel}
        </Button>
        <PreSaleCountdown showCountdown={false} />
      </Fragment>
    )}
  </nav>
</header>
