---
import type { HTMLAttributes } from 'astro/types';
import Logo from '../../../assets/logo.svg?raw';
import Button from '../../ui/Button.astro';
import { getCurrentLocale, requireEntry } from '../../../lib/i18n';

interface NavLink {
  label: string;
  href: string;
}

interface Props extends HTMLAttributes<'header'> {
  navLinks?: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
  class?: string;
}

const locale = getCurrentLocale();
const entry = await requireEntry('nav', locale);
const defaults = entry.data;

const {
  navLinks = defaults.links,
  ctaLabel = defaults.cta.label,
  ctaHref = defaults.cta.href,
  class: className,
  ...rest
} = Astro.props;
---

<header
  class:list={[
    'sticky top-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-border/30',
    className,
  ]}
  {...rest}
>
  <nav class="flex justify-between items-center max-w-screen-2xl mx-auto px-6 h-20" aria-label="Główna nawigacja">
    <a href="/ux-designer" class="text-primary block h-8 [&>svg]:h-full [&>svg]:w-auto" aria-label="Creative Sparks">
      <Fragment set:html={Logo} />
    </a>

    <div class="hidden md:flex items-center gap-10 font-normal font-label tracking-tight text-[13px]">
      {navLinks.map((link) => (
        <a href={link.href} class="text-foreground/70 hover:text-primary transition-colors">
          {link.label}
        </a>
      ))}
    </div>

    <Button href={ctaHref} size="sm" class="hidden sm:inline-flex" data-umami-event="Nav CTA">
      {ctaLabel}
    </Button>
  </nav>
</header>
