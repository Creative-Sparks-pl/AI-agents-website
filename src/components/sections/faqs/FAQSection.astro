---
import type { HTMLAttributes } from 'astro/types';
import { getCollection } from 'astro:content';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import sectionIcon from '../../../assets/icons/shape-11.svg';
import { localeFromPathname, getLocalizedCollection } from '../../../lib/i18n';
import FAQItem from './FAQItem.astro';

interface FAQEntry {
  q: string;
  body: string;
  link?: { label: string; href: string; icon?: string; sub?: string };
  open?: boolean;
}

interface Props extends HTMLAttributes<'section'> {
  class?: string;
  heading?: string;
  entries?: FAQEntry[];
}

const { class: className, heading, entries: entriesProp, ...rest } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);

let entries: FAQEntry[];
if (entriesProp) {
  entries = entriesProp;
} else {
  const faqs = (await getLocalizedCollection('faqs', locale))
    .sort((a, b) => a.data.order - b.data.order);
  entries = faqs.map((f) => ({
    q: f.data.q,
    body: f.body?.trim() ?? '',
    link: f.data.link,
  }));
}

const defaultHeading = locale === 'en' ? 'Questions we usually get' : 'Pytania, które zwykle padają';
const resolvedHeading = heading ?? defaultHeading;
---

<section
  class:list={['py-20 md:py-28 px-6 bg-surface-primary', className]}
  id="faq"
  aria-labelledby="faq-heading"
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">FAQ</span>
        <h2 id="faq-heading" class="font-headline text-4xl md:text-5xl font-bold text-foreground leading-[1.1] tracking-tight">
          {resolvedHeading}
        </h2>
      </Fragment>

      <div class="flex flex-col">
        {entries.map((faq, i) => (
          <FAQItem index={i} q={faq.q} link={faq.link} open={faq.open}>
            {faq.body}
          </FAQItem>
        ))}
      </div>
    </SectionWithIcon>
  </div>
</section>
