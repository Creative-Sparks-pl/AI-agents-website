---
import LinkArrow from '../../ui/LinkArrow.astro';

interface Link {
  label: string;
  href: string;
  icon?: string;
  sub?: string;
}

interface Props {
  index: number;
  q: string;
  link?: Link;
}

const { index, q, link } = Astro.props;
---

<details class="group border-b border-border/30 overflow-hidden bg-white" name="faq">
  <summary class="flex items-start justify-between p-6 md:p-10 cursor-pointer list-none hover:bg-surface transition-colors">
    <div class="flex flex-col md:flex-row gap-4 md:gap-12 flex-1 md:items-start">
      <span class="font-label text-xs font-bold text-muted w-16 hidden sm:block leading-[1.4]">
        {String(index + 1).padStart(2, '0')}
      </span>
      <h3 class="font-headline font-bold text-lg md:text-xl tracking-tight leading-tight text-foreground">
        {q}
      </h3>
    </div>
    <span class="material-symbols-outlined text-muted expand-icon transition-transform duration-300 pt-2" aria-hidden="true">expand_more</span>
  </summary>
  <div class="px-6 pb-10 md:pb-12 md:pl-[152px] md:pr-10">
    <p class="text-muted text-lg leading-relaxed max-w-3xl"><slot /></p>
    {link && (
      <LinkArrow href={link.href} class="mt-4">
        {link.label}
      </LinkArrow>
    )}
  </div>
</details>

<style is:global>
  details[name="faq"][open] summary .expand-icon {
    transform: rotate(180deg);
  }

  details[name="faq"][open] summary:hover {
    background-color: transparent;
  }

  details[name="faq"] summary::-webkit-details-marker {
    display: none;
  }
</style>
