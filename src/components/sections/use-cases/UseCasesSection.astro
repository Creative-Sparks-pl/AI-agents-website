---
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import ExampleCard from './ExampleCard.astro';
import CaseCard from './CaseCard.astro';

interface Link {
  label: string;
  href: string;
  icon?: string;
  sub?: string;
}

interface Case {
  number?: string;
  audience?: string;
  title: string;
  description: string;
  bullets?: string[];
  quote?: string;
  links: Link[];
}

interface Examples {
  badge?: string;
  heading?: string;
  items: Link[];
}

interface Props extends HTMLAttributes<'section'> {
  headingId: string;
  badge: string;
  heading: string;
  cases: Case[];
  examples?: Examples;
  icon?: ImageMetadata;
  groupName?: string;
  class?: string;
}

const {
  headingId,
  badge,
  heading,
  cases,
  examples,
  icon,
  groupName = 'use-cases',
  class: className,
  ...rest
} = Astro.props;
---

<section
  class:list={['py-20 md:py-28 px-6 bg-surface-primary', className]}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto">
    <SectionWithIcon icon={icon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">{badge}</span>
        <h2 id={headingId} class="font-headline font-bold text-4xl md:text-5xl tracking-tight leading-[1.1] text-foreground" set:html={heading} />
      </Fragment>

      <div class="flex flex-col">
        {examples && (
          <div class="border-b border-border/30 overflow-hidden bg-white p-6 md:p-10">
            <div class="flex flex-col md:flex-row gap-4 md:gap-12 md:items-start">
              {examples.badge && (
                <span class="font-label text-xs font-bold text-muted w-16 hidden sm:block leading-[1.4] shrink-0">
                  {examples.badge}
                </span>
              )}
              <div class="flex flex-col gap-10 flex-1">
                {examples.heading && (
                  <h3 class="font-headline font-bold text-2xl md:text-3xl tracking-tight leading-tight text-foreground" set:html={examples.heading} />
                )}
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px">
                  {examples.items.map((ex) => (
                    <ExampleCard label={ex.label} href={ex.href} icon={ex.icon} sub={ex.sub} />
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

        {cases.map((c) => (
          <CaseCard
            number={c.number}
            audience={c.audience}
            title={c.title}
            description={c.description}
            bullets={c.bullets}
            quote={c.quote}
            links={c.links}
            groupName={groupName}
          />
        ))}
      </div>
    </SectionWithIcon>
  </div>
</section>
