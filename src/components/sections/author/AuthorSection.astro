---
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import authorPhoto from '../../../assets/author.webp';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import sectionIcon from '../../../assets/icons/shape-6.svg';
import { localeFromPathname, requireEntry, requireLocalizedEntry } from '../../../lib/i18n';

interface Props extends HTMLAttributes<'section'> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);
const entry = await requireLocalizedEntry('author', locale);
const { badge, heading, nameFirst, nameLast, role, bio, email, contactNote, linkedIn, experienceLabel, experienceValue } = entry.data;

---

<section
  class:list={['py-20 md:py-28 bg-surface', className]}
  aria-labelledby="author-heading"
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">{badge}</span>
        <h2 id="author-heading" class="font-headline text-4xl md:text-5xl font-bold text-foreground leading-[1.1] tracking-tight">
          {heading}
        </h2>
      </Fragment>

      <div class="grid grid-cols-12 gap-x-8 lg:gap-x-16 items-start">
        <div class="col-span-12 lg:col-span-5 relative mb-16 lg:mb-0">
          <div class="aspect-[4/5] bg-white shadow-[0_24px_48px_-12px_rgba(0,7,188,0.08)] relative overflow-hidden">
            <Image
              src={authorPhoto}
              alt={`${nameFirst} ${nameLast}`}
              class="w-full h-full object-cover"
              widths={[400, 600]}
              sizes="(max-width: 1024px) 100vw, 40vw"
            />
          </div>
          <div class="absolute -bottom-8 -left-4 md:-left-8 bg-primary p-6 text-white shadow-xl hidden md:block">
            <p class="font-label text-xs text-white/70 mb-1">{experienceLabel}</p>
            <p class="font-headline font-bold text-3xl">{experienceValue}</p>
          </div>
        </div>

        <div class="col-span-12 lg:col-span-6 lg:col-start-7 flex flex-col justify-center lg:self-center">
          <h3 class="font-headline font-bold text-4xl md:text-5xl text-foreground leading-[1.1] tracking-tight mb-2">
            {nameFirst} <span class="text-primary">{nameLast}</span>,
          </h3>
          <p class="font-headline font-bold text-2xl md:text-3xl text-muted mb-8" set:html={role}></p>

          <div class="space-y-6 max-w-xl">
            <p class="text-lg md:text-xl text-muted leading-relaxed font-body">
              {bio}
            </p>

            <div class="pt-8 border-l-4 border-accent pl-6">
              <p class="text-base text-muted mb-5 font-body">{contactNote}</p>
              <a class="group flex items-center gap-3" href={`mailto:${email}`}>
                <span class="font-headline font-bold text-xl md:text-2xl text-primary group-hover:text-foreground transition-colors">
                  {email}
                </span>
                <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform" data-icon="arrow_forward" aria-hidden="true">arrow_forward</span>
              </a>

              {linkedIn && (
                <a class="group inline-flex items-center gap-3 mt-4" href={linkedIn} target="_blank" rel="noopener">
                  <span class="font-headline font-bold text-xl md:text-2xl text-primary group-hover:text-foreground transition-colors">
                    {locale === 'en' ? 'LinkedIn profile' : 'Profil LinkedIn'}
                  </span>
                  <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform" data-icon="arrow_forward" aria-hidden="true">arrow_forward</span>
                </a>
              )}
            </div>
          </div>

        </div>
      </div>
    </SectionWithIcon>
  </div>
</section>

<style>
  .author-agency-link {
    color: var(--color-primary, #0007bc);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-primary, #0007bc) 30%, transparent);
    transition: text-decoration-color 0.3s, color 0.3s;
    animation: author-link-pulse 3.2s ease-in-out infinite;
  }

  .author-agency-link:hover {
    text-decoration-color: var(--color-primary, #0007bc);
    animation: none;
  }

  @keyframes author-link-pulse {
    0%, 100% { text-decoration-color: color-mix(in srgb, var(--color-primary, #0007bc) 25%, transparent); }
    50% { text-decoration-color: var(--color-primary, #0007bc); }
  }

  @media (prefers-reduced-motion: reduce) {
    .author-agency-link {
      animation: none;
    }
  }
</style>
