---
import type { HTMLAttributes } from 'astro/types';
import { getCollection } from 'astro:content';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import LinkArrow from '../../ui/LinkArrow.astro';
import Button from '../../ui/Button.astro';
import sectionIcon from '../../../assets/icons/shape-9.svg';
import { localeFromPathname, getLocalizedCollection } from '../../../lib/i18n';
import DecisionCard from './DecisionCard.astro';

interface DecisionItem {
  icon: string;
  label: string;
  title: string;
  desc: string;
}

interface Props extends HTMLAttributes<'section'> {
  class?: string;
  badge?: string;
  heading?: string;
  lead?: string;
  link?: { href: string; label: string } | null;
  decisions?: DecisionItem[];
  cta?: { heading: string; description: string; button: { label: string; href: string } };
}

const DEFAULT_BADGE = 'Pod maską';
const DEFAULT_HEADING = 'To nie jest jeden prompt,<br />tylko ~25 000 linijek kodu<br />i przemyślana architektura systemu.';
const DEFAULT_LEAD = 'Asystent to instrukcja działania + 92 pliki wiedzy domenowej, ładowane na żądanie. Dojście do tej architektury zajęło kilka miesięcy. Obecna architektura to trzecie podejście. Dwa wcześniejsze nie spełniały wymagań.';
const DEFAULT_LINK = { href: '/ux-design-skill/changelog', label: 'Historia zmian i aktualizacji' };

const {
  class: className,
  badge = DEFAULT_BADGE,
  heading = DEFAULT_HEADING,
  lead = DEFAULT_LEAD,
  link = DEFAULT_LINK,
  decisions: decisionsProp,
  cta,
  ...rest
} = Astro.props;

let decisions: DecisionItem[];
if (decisionsProp) {
  decisions = decisionsProp;
} else {
  const locale = localeFromPathname(Astro.url.pathname);
  const entries = (await getLocalizedCollection('architecture', locale))
    .sort((a, b) => a.data.order - b.data.order);
  decisions = entries.map((d) => ({
    icon: d.data.icon,
    label: d.data.label,
    title: d.data.title,
    desc: d.data.desc,
  }));
}
---

<section
  class:list={['py-20 md:py-28 bg-white', className]}
  id="architektura"
  aria-labelledby="arch-heading"
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">{badge}</span>
        <h2 id="arch-heading" class="font-headline text-4xl md:text-5xl font-bold text-foreground leading-[1.1] tracking-tight" set:html={heading}></h2>
      </Fragment>

      <p class:list={['text-lg text-muted leading-relaxed max-w-3xl', link ? 'mb-4' : 'mb-10']}>
        {lead}
      </p>
      {link && (
        <LinkArrow href={link.href} class="mb-10">
          {link.label}
        </LinkArrow>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-5 bg-primary text-white p-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-accent" aria-hidden="true">folder_open</span>
            <span class="font-label text-sm font-bold uppercase tracking-wider">agents/ux-designer/</span>
          </div>
          <div class="space-y-1 font-label text-sm text-white/60">
            <div class="flex items-center gap-2 py-1.5 pl-4">
              <span class="material-symbols-outlined text-accent text-base" aria-hidden="true">description</span>
              <span>agent.md</span>
            </div>
            <div class="pl-4">
              <div class="flex items-center gap-2 py-1.5 border-l border-white/20 pl-4">
                <span class="material-symbols-outlined text-accent text-base" aria-hidden="true">folder</span>
                <span class="font-bold text-white">references/</span>
              </div>
              <div class="pl-8 border-l border-white/20 ml-4">
                <div class="flex items-center gap-2 py-1.5 pl-4">
                  <span class="material-symbols-outlined text-accent text-base" aria-hidden="true">article</span>
                  <span>constitution.md</span>
                </div>
                <div class="flex items-center gap-2 py-1.5 pl-4">
                  <span class="material-symbols-outlined text-accent text-base" aria-hidden="true">account_tree</span>
                  <span>workflows.md</span>
                </div>
                <div class="flex items-center gap-2 py-1.5 pl-4">
                  <span class="material-symbols-outlined text-accent text-base" aria-hidden="true">folder</span>
                  <span>shared/</span>
                </div>
                <div class="flex items-center gap-2 py-1.5 pl-4">
                  <span class="material-symbols-outlined text-accent text-base" aria-hidden="true">folder</span>
                  <span class="font-bold text-white">domains/</span>
                </div>
                <div class="pl-8 border-l border-white/20 ml-4">
                  <div class="flex items-center gap-2 py-1 pl-4"><span>b2b/</span></div>
                  <div class="flex items-center gap-2 py-1 pl-4"><span>b2b-saas/</span></div>
                  <div class="flex items-center gap-2 py-1 pl-4"><span>b2b-services/</span></div>
                  <div class="flex items-center gap-2 py-1 pl-4"><span>ecommerce/</span></div>
                </div>
              </div>
              <div class="flex items-center gap-2 py-1.5 border-l border-white/20 pl-4">
                <span class="material-symbols-outlined text-accent text-base" aria-hidden="true">folder</span>
                <span class="font-bold text-white">assets/</span>
              </div>
              <div class="pl-8 border-l border-white/20 ml-4">
                <div class="flex items-center gap-2 py-1 pl-4"><span>templates/</span></div>
                <div class="flex items-center gap-2 py-1 pl-4"><span>scripts/</span></div>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {decisions.map((d) => (
            <DecisionCard icon={d.icon} label={d.label} title={d.title} desc={d.desc} />
          ))}
        </div>
      </div>

      {cta && (
        <div class="mt-6 bg-accent p-8 lg:p-10 flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
          <div class="flex-1">
            <h3 class="font-headline text-2xl md:text-3xl font-bold text-foreground tracking-tight leading-tight mb-3">{cta.heading}</h3>
            <p class="text-base text-foreground/80 leading-relaxed font-body">{cta.description}</p>
          </div>
          <div class="shrink-0">
            <Button href={cta.button.href} size="lg" trailingIcon="trending_flat" onclick="setTimeout(function(){window.umami&&window.umami.track('Architecture CTA')},0)">
              {cta.button.label}
            </Button>
          </div>
        </div>
      )}
    </SectionWithIcon>
  </div>
</section>
