---
interface Props {
  name: string;
  sub: string;
  oldPrice: string;
  price: string;
  highlight: boolean;
  features: string[];
}

const { name, sub, oldPrice, price, highlight, features } = Astro.props;
---

<div class:list={[
  'flex flex-col p-10',
  highlight ? 'bg-accent text-foreground' : 'bg-surface'
]}>
  <div class="mb-8">
    <span class="text-xs font-label text-primary mb-2 block">Pakiet</span>
    <h3 class="font-headline font-bold text-3xl mb-2">{name}</h3>
    <p class:list={['text-sm', highlight ? 'text-foreground/70' : 'text-muted']}>{sub}</p>
  </div>

  <div class="mb-8">
    <span class="text-xs font-label text-primary font-bold mb-1 block">Early access</span>
    <span class:list={['text-lg font-label line-through', highlight ? 'text-foreground/40' : 'text-muted/60']}>{oldPrice} zł</span>
    <div>
      <span class="font-headline font-bold text-5xl">{price}</span>
      <span class:list={['text-lg ml-1', highlight ? 'text-foreground/70' : 'text-muted']}>zł</span>
    </div>
    <p class:list={['text-xs font-label mt-1', highlight ? 'text-foreground/50' : 'text-muted/70']}>netto + VAT 23%</p>
  </div>

  <div class:list={['border-t mb-8 pt-8', highlight ? 'border-foreground/10' : 'border-border/30']}>
    <ul class="space-y-4">
      {features.map((feature) => (
        <li class="flex items-start gap-3 text-base">
          <span class="material-symbols-outlined text-lg shrink-0 text-primary" data-icon="check" aria-hidden="true">check</span>
          {feature}
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-auto">
    <a
      href="https://cart.creativesparks.pl/checkout/ux-design-lead"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 w-full py-4 font-extrabold text-base tracking-tight transition-all duration-300 bg-primary text-white hover:bg-black"
      data-umami-event="Pricing CTA"
      data-umami-event-plan={name}
    >
      Odblokuj early access
      <span class="material-symbols-outlined text-base" aria-hidden="true">lock_open</span>
    </a>
  </div>
</div>
