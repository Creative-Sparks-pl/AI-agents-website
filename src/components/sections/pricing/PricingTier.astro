---
import Button from '../../ui/Button.astro';
import { localeFromPathname } from '../../../lib/i18n';

interface Props {
  name: string;
  sub: string;
  oldPrice: string;
  price: string;
  highlight: boolean;
  features: string[];
}

const { name, sub, oldPrice, price, highlight, features } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);

const copy = locale === 'en'
  ? {
      packageLabel: 'Package',
      presaleLabel: 'Pre-sale',
      currencySymbol: '$',
      currencyPosition: 'prefix' as const,
      taxNote: '',
      ctaLabel: (n: string) => `Buy ${n}`,
      checkoutUrl: 'https://cart.creativesparks.pl/checkout/ux-design-skill-en',
    }
  : {
      packageLabel: 'Pakiet',
      presaleLabel: 'Przedsprzedaż',
      currencySymbol: 'zł',
      currencyPosition: 'suffix' as const,
      taxNote: 'netto + VAT 23%',
      ctaLabel: (n: string) => `Kup pakiet ${n}`,
      checkoutUrl: 'https://cart.creativesparks.pl/checkout/ux-design-lead',
    };

const oldPriceDisplay = copy.currencyPosition === 'prefix'
  ? `${copy.currencySymbol}${oldPrice}`
  : `${oldPrice} ${copy.currencySymbol}`;
---

<div class:list={[
  'flex flex-col p-10',
  highlight ? 'bg-accent text-foreground' : 'bg-surface'
]}>
  <div class="mb-8">
    <span class="text-xs font-label text-primary mb-2 block">{copy.packageLabel}</span>
    <h3 class="font-headline font-bold text-3xl mb-2">{name}</h3>
    <p class:list={['text-sm', highlight ? 'text-foreground/70' : 'text-muted']}>{sub}</p>
  </div>

  <div class="mb-8">
    <span class="text-xs font-label text-primary font-bold mb-1 block">{copy.presaleLabel}</span>
    <span class:list={['text-lg font-label line-through block', highlight ? 'text-foreground/40' : 'text-muted/60']}>{oldPriceDisplay}</span>
    <div class="flex items-baseline">
      {copy.currencyPosition === 'prefix' && (
        <span class="font-headline font-bold text-5xl">{copy.currencySymbol}</span>
      )}
      <span class="font-headline font-bold text-5xl">{price}</span>
      {copy.currencyPosition === 'suffix' && (
        <span class:list={['text-lg ml-1', highlight ? 'text-foreground/70' : 'text-muted']}>{copy.currencySymbol}</span>
      )}
    </div>
    {copy.taxNote && (
      <p class:list={['text-xs font-label mt-1', highlight ? 'text-foreground/50' : 'text-muted/70']}>{copy.taxNote}</p>
    )}
  </div>

  <div class:list={['border-t mb-8 pt-8', highlight ? 'border-foreground/10' : 'border-border/30']}>
    <ul class="space-y-4">
      {features.map((feature) => (
        <li class="flex items-start gap-3 text-base">
          <span class="material-symbols-outlined text-lg shrink-0 text-primary" data-icon="check" aria-hidden="true">check</span>
          {feature}
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-auto">
    <Button
      href={copy.checkoutUrl}
      external
      block
      size="md"
      data-umami-event="Pricing CTA"
      data-umami-event-plan={name}
      data-track="InitiateCheckout"
      data-track-plan={name}
    >
      {copy.ctaLabel(name)}
    </Button>
  </div>
</div>
