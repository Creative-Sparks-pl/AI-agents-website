---
import type { HTMLAttributes } from 'astro/types';
import { getCollection } from 'astro:content';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import sectionIcon from '../../../assets/icons/shape-12.svg';
import { localeFromPathname, getLocalizedCollection } from '../../../lib/i18n';
import PricingTier from './PricingTier.astro';
import LinkArrow from '../../ui/LinkArrow.astro';
import PreSaleCountdown from '../../ui/PreSaleCountdown.astro';

interface Props extends HTMLAttributes<'section'> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);
const plans = (await getLocalizedCollection('pricing', locale))
  .sort((a, b) => a.data.order - b.data.order);

const copy = locale === 'en'
  ? {
      heading: 'Do you design sites for your own business or for clients?',
      termsLine: 'One-time license · 12 months of updates · then renewal at about half the price',
      refundNote: '14-day refund. Not a fit? Return it.',
    }
  : {
      heading: 'Projektujesz strony dla swojej firmy czy dla klientów?',
      termsLine: 'Jednorazowa licencja · 12 miesięcy aktualizacji · potem przedłużenie za ok. połowę ceny',
      refundNote: '14 dni na sprawdzenie. Nie pasuje, oddajesz.',
    };
---

<section
  class:list={['py-20 md:py-28 bg-white', className]}
  id={locale === 'en' ? 'pricing' : 'cennik'}
  aria-labelledby="pricing-heading"
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <h2 id="pricing-heading" class="font-headline text-4xl md:text-5xl font-bold text-foreground leading-[1.1] tracking-tight">
          {copy.heading}
        </h2>
        {locale === 'pl' && (
          <p class="text-lg md:text-xl text-muted leading-relaxed mt-6">
            12 miesięcy darmowych aktualizacji w cenie.
            <LinkArrow href="/ux-design-skill/changelog/" class="ml-2 align-baseline text-base [&_.material-symbols-outlined]:text-base">
              Zobacz changelog
            </LinkArrow>
          </p>
        )}
      </Fragment>

      {/* The first card reports "Pricing seen": on phones the whole section is too tall to be half on screen.
          Each card's wrapper is a grid, so the card still fills the row's height; from md up it passes the four
          shared rows on to the card (subgrid), and those rows carry no gap of their own. */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-y-0">
        {plans.map((plan, i) => (
          <div class="grid md:grid-rows-subgrid md:row-span-4" data-umami-seen={i === 0 ? 'Pricing seen' : undefined}>
            <PricingTier
              name={plan.data.name}
              group={plan.data.group}
              value={plan.data.value}
              listPrice={plan.data.listPrice}
              salePrice={plan.data.salePrice}
              listCheckoutUrl={plan.data.listCheckoutUrl}
              saleCheckoutUrl={plan.data.saleCheckoutUrl}
              highlight={plan.data.highlight}
              features={plan.data.features}
            />
          </div>
        ))}
      </div>

      <p class="mt-8 text-center text-base text-muted">{copy.termsLine}</p>

      <div class="mt-4 px-8 py-4 flex items-center justify-center gap-3 text-center">
        <span class="material-symbols-outlined text-primary text-xl shrink-0" aria-hidden="true">task_alt</span>
        <p class="font-headline text-base md:text-lg font-bold text-foreground tracking-tight">{copy.refundNote}</p>
      </div>

    </SectionWithIcon>
  </div>
  {/* Swaps the cards' prices and buy links at the edges of the sale window. */}
  <PreSaleCountdown showCountdown={false} />
</section>
