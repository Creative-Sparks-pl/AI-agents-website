---
import type { HTMLAttributes } from 'astro/types';
import { getCollection } from 'astro:content';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import sectionIcon from '../../../assets/icons/shape-12.svg';
import { getCurrentLocale } from '../../../lib/i18n';
import PricingTier from './PricingTier.astro';
import LinkArrow from '../../ui/LinkArrow.astro';

interface Props extends HTMLAttributes<'section'> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;

const locale = getCurrentLocale();
const plans = (await getCollection('pricing', (e) => e.id.startsWith(`${locale}/`)))
  .sort((a, b) => a.data.order - b.data.order);
---

<section
  class:list={['py-20 md:py-28 bg-white', className]}
  id="cennik"
  aria-labelledby="pricing-heading"
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <div class="inline-flex items-center gap-2 bg-primary/5 px-4 py-1.5 border border-primary/20 mb-6">
          <span class="material-symbols-outlined text-primary text-sm" data-icon="auto_awesome" aria-hidden="true">auto_awesome</span>
          <span class="text-sm font-bold text-primary font-label">Cennik przedsprzedaży do 30 maja 2026</span>
        </div>
        <h2 id="pricing-heading" class="font-headline text-4xl md:text-5xl font-bold text-foreground leading-[1.1] tracking-tight">
          Trzy pakiety, jednorazowa licencja
        </h2>
        <p class="text-lg md:text-xl text-muted leading-relaxed mt-6">
          Sześć miesięcy darmowych aktualizacji w cenie i aż dwanaście w przedsprzedaży.
          <LinkArrow href="/ux-designer/changelog" class="ml-2 align-baseline text-base [&_.material-symbols-outlined]:text-base">
            Zobacz changelog
          </LinkArrow>
        </p>
        <p class="text-base md:text-lg text-primary font-medium leading-relaxed mt-3">
          1 czerwca 2026 startuje globalna sprzedaż i wchodzą wyższe ceny w euro.
        </p>
      </Fragment>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {plans.map((plan) => (
          <PricingTier
            name={plan.data.name}
            sub={plan.data.sub}
            oldPrice={plan.data.oldPrice}
            price={plan.data.price}
            highlight={plan.data.highlight}
            features={plan.data.features}
          />
        ))}
      </div>

      <div class="mt-8 px-8 py-4 flex items-center justify-center gap-3 text-center">
        <span class="material-symbols-outlined text-primary text-xl shrink-0" aria-hidden="true">task_alt</span>
        <p class="font-headline text-base md:text-lg font-bold text-foreground tracking-tight">14 dni na sprawdzenie. Nie pasuje, oddajesz.</p>
      </div>

    </SectionWithIcon>
  </div>
</section>
