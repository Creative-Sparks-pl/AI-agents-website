---
import type { HTMLAttributes } from 'astro/types';
import { getCollection } from 'astro:content';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import sectionIcon from '../../../assets/icons/shape-12.svg';
import { localeFromPathname, getLocalizedCollection } from '../../../lib/i18n';
import PricingTier from './PricingTier.astro';
import LinkArrow from '../../ui/LinkArrow.astro';
import PreSaleCountdown from '../../ui/PreSaleCountdown.astro';
import { isPresaleActive } from '../../../lib/presale';

interface Props extends HTMLAttributes<'section'> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);
const plans = (await getLocalizedCollection('pricing', locale))
  .sort((a, b) => a.data.order - b.data.order);

const copy = locale === 'en'
  ? {
      heading: 'Three packages, one-time license',
      refundNote: '14-day refund. Not a fit? Return it.',
    }
  : {
      heading: 'Trzy pakiety, jednorazowa licencja',
      refundNote: '14 dni na sprawdzenie. Nie pasuje, oddajesz.',
    };
---

<section
  class:list={['py-20 md:py-28 bg-white', className]}
  id="cennik"
  aria-labelledby="pricing-heading"
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <div
          class="inline-flex items-center gap-2 bg-accent border border-accent text-foreground px-4 py-1.5 mb-6"
          data-presale-badge
          style={isPresaleActive(Date.now()) ? undefined : 'display:none'}
        >
          <span class="material-symbols-outlined text-primary text-sm" data-icon="auto_awesome" aria-hidden="true">auto_awesome</span>
          <span class="text-sm font-bold text-foreground font-label">
            <PreSaleCountdown />
          </span>
        </div>
        <h2 id="pricing-heading" class="font-headline text-4xl md:text-5xl font-bold text-foreground leading-[1.1] tracking-tight">
          {copy.heading}
        </h2>
        {locale === 'pl' && (
          <p class="text-lg md:text-xl text-muted leading-relaxed mt-6">
            Sześć miesięcy darmowych aktualizacji w cenie.
            <LinkArrow href="/ux-design-skill/changelog" class="ml-2 align-baseline text-base [&_.material-symbols-outlined]:text-base">
              Zobacz changelog
            </LinkArrow>
          </p>
        )}
      </Fragment>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {plans.map((plan) => (
          <PricingTier
            name={plan.data.name}
            sub={plan.data.sub}
            oldPrice={plan.data.oldPrice}
            price={plan.data.price}
            highlight={plan.data.highlight}
            features={plan.data.features}
          />
        ))}
      </div>

      <div class="mt-8 px-8 py-4 flex items-center justify-center gap-3 text-center">
        <span class="material-symbols-outlined text-primary text-xl shrink-0" aria-hidden="true">task_alt</span>
        <p class="font-headline text-base md:text-lg font-bold text-foreground tracking-tight">{copy.refundNote}</p>
      </div>

    </SectionWithIcon>
  </div>
</section>
