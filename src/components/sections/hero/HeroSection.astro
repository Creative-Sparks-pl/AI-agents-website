---
import type { HTMLAttributes } from 'astro/types';
import Button from '../../ui/Button.astro';
import ChecklistItem from '../../ui/ChecklistItem.astro';
import { getCurrentLocale, requireEntry } from '../../../lib/i18n';

interface Props extends HTMLAttributes<'section'> {
  entryId?: string;
  class?: string;
}

const { entryId, class: className, ...rest } = Astro.props;

const locale = getCurrentLocale();
const entry = await requireEntry('hero', entryId ?? locale);
const { badge, badgeIcon, badgeNote, headlineLead, headlineEm, headlineTail, tagline, bullets, ctaPrimary, ctaSecondary, videoLabel = 'Demo możliwości asystenta UX' } = entry.data;
---

<section
  class:list={[
    'relative overflow-hidden architectural-grid',
    className,
  ]}
  aria-labelledby="hero-heading"
  {...rest}
>
  <div class="pt-12 pb-20 md:pb-28">
    <div class="max-w-screen-2xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 bg-primary/5 px-4 py-1.5 border border-primary/20 mb-8">
          <span class="material-symbols-outlined text-primary text-sm" aria-hidden="true">{badgeIcon}</span>
          <span class="text-sm font-bold text-primary font-label">{badge}</span>
        </div>

        <h1 id="hero-heading" class="font-headline text-5xl md:text-7xl font-extrabold tracking-tighter leading-[1.05] mb-6 text-foreground">
          {headlineLead} <span class="text-primary">{headlineEm}</span> {headlineTail}
        </h1>

        <p class="text-2xl text-foreground leading-snug mb-10 font-medium">
          {tagline}
        </p>

        <ul class="space-y-5 mb-12">
          {bullets.map((bullet) => (
            <li>
              <ChecklistItem title={bullet} />
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row items-start gap-4">
          <Button href={ctaPrimary.href} size="lg" trailingIcon={ctaPrimary.icon} onclick="setTimeout(function(){window.umami&&window.umami.track('Hero primary CTA')},0)">
            {ctaPrimary.label}
          </Button>
          <Button href={ctaSecondary.href} size="lg" variant="secondary" trailingIcon={ctaSecondary.icon} onclick="setTimeout(function(){window.umami&&window.umami.track('Hero secondary CTA')},0)">
            {ctaSecondary.label}
          </Button>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <script is:inline async src="https://fast.wistia.com/player.js"></script>
        <script is:inline async type="module" src="https://fast.wistia.com/embed/1siqhsesz9.js"></script>
        <wistia-player
          media-id="1siqhsesz9"
          popover-content="link"
          wistia-popover="true"
          aspect="1.7777777777777777"
          style="display: block;"
        >
          <a href="#" class="block group cursor-pointer">
            <div class="relative shadow-[24px_24px_0px_#E5FA00] overflow-hidden border-t-4 border-primary">
              <div class="bg-zinc-900 p-6 font-label text-sm text-zinc-300 leading-relaxed">
                <div class="flex gap-2 mb-4 border-b border-zinc-800 pb-2">
                  <div class="w-3 h-3 rounded-full bg-accent/30"></div>
                  <div class="w-3 h-3 rounded-full bg-accent/30"></div>
                  <div class="w-3 h-3 rounded-full bg-accent/30"></div>
                </div>
                <p class="text-accent">// ASYSTENT UX: DISCOVERY</p>

                <p class="mt-4"><span class="text-primary font-bold">[INPUT]</span></p>
                <p class="mt-2 text-zinc-400 italic">"Tworzę stronę dla kancelarii prawnej</p>
                <p class="text-zinc-400 italic">z Wrocławia, specjalizacja prawo pracy"</p>

                <p class="mt-4"><span class="text-primary font-bold">[ODPOWIEDŹ AGENTA]</span></p>
                <p class="mt-2">• Typ strony: Local business (<span class="text-emerald-400">🟢</span> wynika z kontekstu)</p>
                <p class="mt-1">• Branża: Kancelaria prawna, prawo pracy (<span class="text-emerald-400">🟢</span> wynika z kontekstu)</p>
                <p class="mt-1">• Cel: pozyskiwanie klientów B2B i B2C (<span class="text-amber-400">🟡</span> zweryfikuj)</p>
                <p class="mt-1">• Persona: HR manager, 50-200 pracowników (<span class="text-amber-400">🟡</span> zweryfikuj)</p>
                <p class="mt-1">• Świadomość: szukają po objawach</p>
                <p class="pl-4">(<span class="text-amber-400">🟡</span> zweryfikuj — "zwolnienie pracownika" nie "kancelaria")</p>
                <p class="mt-1">• Wyróżnik: specjalizacja w prawie pracy (<span class="text-emerald-400">🟢</span> wynika z kontekstu)</p>

                <p class="mt-4 text-white font-bold">PYTANIA:</p>
                <p class="mt-2">1. Klient docelowy — firmy, osoby prywatne, czy oba?</p>
                <p class="mt-1">2. Główna akcja na stronie — kontakt,</p>
                <p class="pl-4">formularz, konsultacja online?</p>
              </div>
              <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
                <svg class="w-48 h-auto" viewBox="0 0 150 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path opacity="0.8" d="M125 0H25C11.1929 0 0 11.1929 0 25V75C0 88.8071 11.1929 100 25 100H125C138.807 100 150 88.8071 150 75V25C150 11.1929 138.807 0 125 0Z" fill="#010DFF"/>
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M97 49.5L77.5 36.25L58 23C58 55.86 58 43.14 58 76L77.5 62.75L97 49.5Z" fill="white"/>
                </svg>
              </div>
            </div>
            <div class="flex justify-center mt-12">
              <span class="inline-flex items-center gap-2 text-primary font-label font-bold text-base tracking-tight">
                <span class="material-symbols-outlined text-xl" aria-hidden="true">play_arrow</span>
                {videoLabel}
              </span>
            </div>
          </a>
        </wistia-player>
      </div>
    </div>
  </div>
</section>

<style>
  .architectural-grid {
    background-image: linear-gradient(to right, rgba(1, 13, 255, 0.05) 1px, transparent 1px),
                      linear-gradient(to bottom, rgba(1, 13, 255, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
  }
</style>
