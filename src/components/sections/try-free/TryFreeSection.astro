---
import type { HTMLAttributes } from 'astro/types';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import sectionIcon from '../../../assets/icons/shape-6.svg';
import { localeFromPathname, requireLocalizedEntry } from '../../../lib/i18n';
import TryFreeCard from './TryFreeCard.astro';

interface Props extends HTMLAttributes<'section'> {
  headingId?: string;
  class?: string;
}

const { headingId = 'try-free-heading', class: className, ...rest } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);
const entry = await requireLocalizedEntry('try-free', locale);
const { badge, heading, intro, submitLabel, pageLabel, cards } = entry.data;
---

<section
  class:list={['py-20 md:py-28 bg-surface-primary', className]}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">{badge}</span>
        <h2 id={headingId} class="font-headline text-4xl md:text-5xl font-bold text-foreground tracking-tight leading-[1.1]">{heading}</h2>
        <p class="text-lg md:text-xl text-muted leading-relaxed mt-6 max-w-3xl">{intro}</p>
      </Fragment>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {cards.map((card) => (
          <TryFreeCard {...card} submitLabel={submitLabel} pageLabel={pageLabel} />
        ))}
      </div>
    </SectionWithIcon>
  </div>
</section>
