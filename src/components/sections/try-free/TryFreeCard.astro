---
import FreeSkillForm from '../../ui/FreeSkillForm.astro';
import LinkArrow from '../../ui/LinkArrow.astro';

interface Props {
  skill: 'audit' | 'planning';
  surface: string;
  question: string;
  name: string;
  text: string;
  note?: string;
  pageHref: string;
  pageLabel: string;
  submitLabel: string;
  videoId?: string;
  videoLabel: string;
}

const { skill, surface, question, name, text, note, pageHref, pageLabel, submitLabel, videoId, videoLabel } = Astro.props;
---

<div class="flex flex-col bg-white p-8 lg:p-10" data-try-free-card={skill}>
  <p class="text-sm font-label text-primary mb-2">{question}</p>
  <h3 class="font-headline font-bold text-2xl tracking-tight leading-tight text-foreground mb-4">{name}</h3>
  <div class="space-y-3 mb-8">
    <p class="text-lg text-muted leading-relaxed">{text}</p>
    {note && <p class="text-sm text-muted leading-relaxed">{note}</p>}
  </div>

  <div class="mt-auto">
    <FreeSkillForm skill={skill} surface={surface} submitLabel={submitLabel} fitContainer block />

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-6">
      <LinkArrow href={pageHref} icon="description" trailingIcon="trending_flat">
        {pageLabel}
      </LinkArrow>
      {videoId && (
        <Fragment>
          <script is:inline async src="https://fast.wistia.com/player.js"></script>
          <script is:inline async type="module" src={`https://fast.wistia.com/embed/${videoId}.js`}></script>
          <wistia-player
            media-id={videoId}
            popover-content="link"
            wistia-popover="true"
            aspect="1.7777777777777777"
            class="w-fit"
          >
            {/* Block-level, so the player adds no line height and both links stay level. */}
            <LinkArrow href="#" icon="play_arrow" trailingIcon="trending_flat" class="!flex">
              {videoLabel}
            </LinkArrow>
          </wistia-player>
        </Fragment>
      )}
    </div>
  </div>
</div>
