---
import FreeSkillForm from '../../ui/FreeSkillForm.astro';
import LinkArrow from '../../ui/LinkArrow.astro';

interface Props {
  skill: 'audit' | 'planning';
  surface: string;
  question: string;
  name: string;
  text: string;
  pageHref: string;
  pageLabel: string;
  submitLabel: string;
}

const { skill, surface, question, name, text, pageHref, pageLabel, submitLabel } = Astro.props;
---

<div class="flex flex-col bg-white p-8 lg:p-10" data-try-free-card={skill}>
  <p class="text-sm font-label text-primary mb-2">{question}</p>
  <h3 class="font-headline font-bold text-2xl tracking-tight leading-tight text-foreground mb-4">{name}</h3>
  <p class="text-lg text-muted leading-relaxed mb-8">{text}</p>

  <div class="mt-auto">
    <FreeSkillForm skill={skill} surface={surface} submitLabel={submitLabel} fitContainer block />

    <div class="mt-6">
      <LinkArrow href={pageHref} icon="description" trailingIcon="trending_flat">
        {pageLabel}
      </LinkArrow>
    </div>
  </div>
</div>
