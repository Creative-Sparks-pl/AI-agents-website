---
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import StageCard from '../../ui/StageCard.astro';

interface Card {
  index?: number;
  title: string;
  description: string;
  output?: string;
  outputLink?: string;
  outputIcon?: string;
  quote?: string;
  shape?: string;
  trackEvent?: string;
  trackParams?: Record<string, string>;
}

interface VideoTile {
  mediaId: string;
  label?: string;
  title?: string;
}

interface Props extends HTMLAttributes<'section'> {
  headingId: string;
  badge: string;
  heading: string;
  lead?: string;
  cards: Card[];
  videoTile?: VideoTile;
  icon?: ImageMetadata;
  class?: string;
}

const {
  headingId,
  badge,
  heading,
  lead,
  cards,
  videoTile,
  icon,
  class: className,
  ...rest
} = Astro.props;
---

<section
  class:list={['py-20 md:py-28 bg-surface', className]}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={icon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">{badge}</span>
        <h2 id={headingId} class="font-headline text-4xl md:text-5xl font-bold text-foreground tracking-tight leading-[1.1]" set:html={heading} />
        {lead && (
          <p class="text-lg md:text-xl text-foreground leading-relaxed mt-6">
            {lead}
          </p>
        )}
      </Fragment>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-16">
        {cards.map((card, i) => (
          <StageCard
            index={card.index ?? i}
            title={card.title}
            description={card.description}
            output={card.output}
            outputLink={card.outputLink}
            outputIcon={card.outputIcon}
            quote={card.quote}
            shape={card.shape}
            trackEvent={card.trackEvent}
            trackParams={card.trackParams}
          />
        ))}
        {videoTile && (
          <Fragment>
            <script is:inline async src="https://fast.wistia.com/player.js"></script>
            <script is:inline async type="module" src={`https://fast.wistia.com/embed/${videoTile.mediaId}.js`}></script>
            <div class="bg-white p-10 flex flex-col gap-6">
              <div class="flex items-start justify-between">
                <div class="w-12 h-12 border-2 border-primary flex items-center justify-center">
                  <span class="material-symbols-outlined text-primary text-2xl" aria-hidden="true">play_arrow</span>
                </div>
                {videoTile.label && (
                  <span class="font-label text-xs text-muted">{videoTile.label}</span>
                )}
              </div>
              {videoTile.title && (
                <h3 class="text-2xl md:text-3xl font-headline font-bold tracking-tight text-foreground">{videoTile.title}</h3>
              )}
              <div set:html={`<wistia-player media-id="${videoTile.mediaId}" wistia-popover="true" aspect="1.7777777777777777"></wistia-player>`} />
            </div>
          </Fragment>
        )}
      </div>

      <slot />
    </SectionWithIcon>
  </div>
</section>
