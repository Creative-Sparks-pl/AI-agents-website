---
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import StageCard from '../../ui/StageCard.astro';

interface Card {
  index?: number;
  title: string;
  description: string;
  output?: string;
  outputLink?: string;
  outputIcon?: string;
  quote?: string;
  shape?: string;
}

interface Props extends HTMLAttributes<'section'> {
  headingId: string;
  badge: string;
  heading: string;
  lead?: string;
  cards: Card[];
  icon?: ImageMetadata;
  class?: string;
}

const {
  headingId,
  badge,
  heading,
  lead,
  cards,
  icon,
  class: className,
  ...rest
} = Astro.props;
---

<section
  class:list={['py-20 md:py-28 bg-surface', className]}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={icon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">{badge}</span>
        <h2 id={headingId} class="font-headline text-4xl md:text-5xl font-bold text-foreground tracking-tight leading-[1.1]" set:html={heading} />
        {lead && (
          <p class="text-lg md:text-xl text-foreground leading-relaxed mt-6">
            {lead}
          </p>
        )}
      </Fragment>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-16">
        {cards.map((card, i) => (
          <StageCard
            index={card.index ?? i}
            title={card.title}
            description={card.description}
            output={card.output}
            outputLink={card.outputLink}
            outputIcon={card.outputIcon}
            quote={card.quote}
            shape={card.shape}
          />
        ))}
      </div>

      <slot />
    </SectionWithIcon>
  </div>
</section>
