---
interface Props {
  icon: string;
  label?: string;
  title: string;
  description: string;
}

const { icon, label, title, description } = Astro.props;
---

<div class="p-10 bg-surface-accent hover:bg-primary hover:text-white transition-all duration-300 group">
  <span class="material-symbols-outlined text-primary group-hover:text-white text-3xl mb-8 block" aria-hidden="true">{icon}</span>
  {label && (
    <span class="font-label text-xs font-bold text-primary group-hover:text-white/80 mb-2 block">{label}</span>
  )}
  <h3 class="text-lg font-headline font-bold tracking-tight mb-4 leading-tight">{title}</h3>
  <p class="text-base font-body opacity-70 leading-relaxed">{description}</p>
</div>
