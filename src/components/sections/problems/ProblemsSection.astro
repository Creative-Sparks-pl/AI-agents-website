---
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import LinkArrow from '../../ui/LinkArrow.astro';
import ProblemCard from './ProblemCard.astro';

interface Link {
  label: string;
  href: string;
  icon?: string;
}

interface Item {
  icon: string;
  label?: string;
  title: string;
  description: string;
}

interface Props extends HTMLAttributes<'section'> {
  headingId: string;
  badge: string;
  heading: string;
  intro?: string;
  items: Item[];
  columns?: 2 | 3 | 4;
  footerNote?: string;
  footerLink?: Link;
  icon?: ImageMetadata;
  class?: string;
}

const {
  headingId,
  badge,
  heading,
  intro,
  items,
  columns = 4,
  footerNote,
  footerLink,
  icon,
  class: className,
  ...rest
} = Astro.props;

const gridClass = {
  2: 'grid grid-cols-1 md:grid-cols-2 gap-4',
  3: 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4',
  4: 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4',
}[columns];
---

<section
  class:list={['py-20 md:py-28 bg-white', className]}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={icon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">{badge}</span>
        <h2 id={headingId} class="font-headline text-4xl md:text-5xl font-bold text-foreground tracking-tight leading-[1.1]" set:html={heading} />
      </Fragment>

      {intro && (
        <p class="text-lg md:text-xl text-muted leading-relaxed mb-10 max-w-3xl">{intro}</p>
      )}

      <div class={gridClass}>
        {items.map((item) => (
          <ProblemCard icon={item.icon} label={item.label} title={item.title} description={item.description} />
        ))}
      </div>

      {(footerNote || footerLink) && (
        <div class="mt-10 flex flex-col items-start gap-4">
          {footerNote && (
            <p class="text-sm text-muted italic">{footerNote}</p>
          )}
          {footerLink && (
            <LinkArrow href={footerLink.href} icon={footerLink.icon}>
              {footerLink.label}
            </LinkArrow>
          )}
        </div>
      )}
    </SectionWithIcon>
  </div>
</section>
