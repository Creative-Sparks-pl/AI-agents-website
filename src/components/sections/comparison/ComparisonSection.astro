---
import type { HTMLAttributes } from 'astro/types';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import sectionIcon from '../../../assets/icons/shape-5.svg';
import { localeFromPathname, requireEntry } from '../../../lib/i18n';
import ComparisonRow from './ComparisonRow.astro';

interface Props extends HTMLAttributes<'section'> {
  entryId?: string;
  class?: string;
}

const { entryId, class: className, ...rest } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);
const entry = await requireEntry('comparison', entryId ?? locale);
const { badge, heading, lead, columns, rows } = entry.data;
---

<section
  class:list={['py-20 md:py-28 bg-surface-primary', className]}
  aria-labelledby="comparison-heading"
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <span class="text-sm font-label text-primary mb-4">{badge}</span>
        <h2 id="comparison-heading" class="font-headline text-4xl md:text-5xl font-bold text-foreground leading-[1.1] tracking-tight" set:html={heading}></h2>
        {lead && (
          <p class="text-base md:text-lg text-muted leading-relaxed mt-6 italic max-w-3xl">
            {lead}
          </p>
        )}
      </Fragment>

      <div class="overflow-x-auto">
        <div class="min-w-[900px]">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr>
                <th class="p-6 text-xs font-label text-muted"></th>
                {columns.map((col) => (
                  <th class:list={[
                    'p-5 font-headline font-bold text-base align-top',
                    col.highlight ? 'bg-primary text-white' : 'text-muted'
                  ]}>
                    <div>{col.label}</div>
                    {col.sub && (
                      <div class:list={[
                        'mt-2 text-xs font-label font-normal',
                        col.highlight ? 'text-white/80' : 'text-muted/80'
                      ]}>{col.sub}</div>
                    )}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <ComparisonRow feature={row.feature} columns={columns} cells={row.cells} />
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </SectionWithIcon>
  </div>
</section>
