---
import { localeFromPathname } from '../../../lib/i18n';

const locale = localeFromPathname(Astro.url.pathname);

const COPY_PL = {
  badge: 'Baza Wiedzy',
  headingLine1: 'Wiedza wbudowana w',
  headingLine2: 'asystenta.',
  description:
    'Bazę wiedzy budowałem latami, ale większość jej objętości powstała przez deep research kierowany na konkretne zagadnienia, wykonywany przez różne modele z różnych źródeł. Rozrosła się na tyle, że stworzyłem osobny moduł do oceny jej jakości i planowania aktualizacji.',
  statFiles: 'Pliki',
  statPageTypes: 'Typów stron',
  statFrameworks: 'Frameworków',
  statPatterns: 'Wzorców sekcji',
  statArchetypes: 'Archetypów',
};

const COPY_EN = {
  badge: 'Knowledge base',
  headingLine1: 'Built into',
  headingLine2: 'the skill.',
  description:
    "I built this knowledge base over years, but most of its volume came from focused deep research runs across different models and sources, each aimed at a specific topic. It grew large enough that I now run a separate module to assess its quality and plan updates.",
  statFiles: 'Files',
  statPageTypes: 'Page types',
  statFrameworks: 'Frameworks',
  statPatterns: 'Section patterns',
  statArchetypes: 'Archetypes',
};

const COPY = locale === 'en' ? COPY_EN : COPY_PL;
---

<section class="pt-6 pb-16 md:pt-8 md:pb-20 px-6">
  <div class="max-w-screen-2xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-end">
      <!-- Left: label + heading + description -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 bg-primary/5 px-4 py-1.5 border border-primary/20 mb-8">
          <span class="material-symbols-outlined text-primary text-sm" aria-hidden="true">menu_book</span>
          <span class="text-sm font-bold text-primary font-label">{COPY.badge}</span>
        </div>
        <h1 class="font-headline text-5xl md:text-7xl lg:text-8xl font-bold text-foreground leading-[0.95] tracking-tight mb-8">
          {COPY.headingLine1}<br />{COPY.headingLine2}
        </h1>
        <p class="text-lg md:text-xl text-muted leading-relaxed max-w-2xl">
          {COPY.description}
        </p>
      </div>

      <!-- Right: stats grid -->
      <div class="lg:col-span-5">
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-surface-primary p-6">
            <p class="text-3xl md:text-4xl font-headline font-bold text-primary">92</p>
            <p class="font-label text-[10px] uppercase text-muted tracking-widest mt-2">{COPY.statFiles}</p>
          </div>
          <div class="bg-surface-primary p-6">
            <p class="text-3xl md:text-4xl font-headline font-bold text-primary">16</p>
            <p class="font-label text-[10px] uppercase text-muted tracking-widest mt-2">{COPY.statPageTypes}</p>
          </div>
          <div class="bg-surface-primary p-6">
            <p class="text-3xl md:text-4xl font-headline font-bold text-primary">13</p>
            <p class="font-label text-[10px] uppercase text-muted tracking-widest mt-2">{COPY.statFrameworks}</p>
          </div>
          <div class="bg-surface-primary p-6">
            <p class="text-3xl md:text-4xl font-headline font-bold text-primary">100+</p>
            <p class="font-label text-[10px] uppercase text-muted tracking-widest mt-2">{COPY.statPatterns}</p>
          </div>
          <div class="bg-surface-primary p-6 col-span-2">
            <p class="text-3xl md:text-4xl font-headline font-bold text-primary">40+</p>
            <p class="font-label text-[10px] uppercase text-muted tracking-widest mt-2">{COPY.statArchetypes}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
