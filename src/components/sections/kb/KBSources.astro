---
import { localeFromPathname } from '../../../lib/i18n';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import sectionIcon from '../../../assets/icons/shape-7.svg';

const locale = localeFromPathname(Astro.url.pathname);

const COPY_PL = {
  badge: 'Źródła',
  heading: 'Eksperci i źródła',
  expertsHeading: 'Eksperci',
  organizationsHeading: 'Organizacje',
  thInstitution: 'Instytucja',
  thDomain: 'Domena wiedzy',
  experts: [
    { name: 'Don Norman', domain: 'Design Psychology & Cognitive Science' },
    { name: 'Jakob Nielsen', domain: 'Web Usability & Heuristics' },
    { name: 'Steve Krug', domain: 'Common Sense Usability' },
    { name: 'Peep Laja', domain: 'Conversion Optimization & Messaging' },
    { name: 'Aarron Walter', domain: 'Emotional Design & User Needs' },
    { name: 'Eugene Schwartz', domain: 'Awareness Levels & Copywriting' },
    { name: 'Robert Cialdini', domain: 'Persuasion Psychology' },
  ],
  organizations: [
    { name: 'Nielsen Norman Group', domain: 'UX Research & Standards' },
    { name: 'Baymard Institute', domain: 'E-commerce UX Patterns' },
    { name: 'CXL Institute', domain: 'Conversion & Data Marketing' },
    { name: 'Reforge', domain: 'Growth & Product Strategy' },
  ],
};

const COPY_EN = {
  badge: 'Sources',
  heading: 'Experts and sources',
  expertsHeading: 'Experts',
  organizationsHeading: 'Organizations',
  thInstitution: 'Institution',
  thDomain: 'Knowledge domain',
  experts: [
    { name: 'Don Norman', domain: 'Design Psychology & Cognitive Science' },
    { name: 'Jakob Nielsen', domain: 'Web Usability & Heuristics' },
    { name: 'Steve Krug', domain: 'Common Sense Usability' },
    { name: 'Peep Laja', domain: 'Conversion Optimization & Messaging' },
    { name: 'Aarron Walter', domain: 'Emotional Design & User Needs' },
    { name: 'Eugene Schwartz', domain: 'Awareness Levels & Copywriting' },
    { name: 'Robert Cialdini', domain: 'Persuasion Psychology' },
  ],
  organizations: [
    { name: 'Nielsen Norman Group', domain: 'UX Research & Standards' },
    { name: 'Baymard Institute', domain: 'E-commerce UX Patterns' },
    { name: 'CXL Institute', domain: 'Conversion & Data Marketing' },
    { name: 'Reforge', domain: 'Growth & Product Strategy' },
  ],
};

const COPY = locale === 'en' ? COPY_EN : COPY_PL;
---

<section class="py-20 md:py-28" id="zrodla">
  <div class="max-w-screen-2xl mx-auto px-6">
    <SectionWithIcon icon={sectionIcon}>
      <Fragment slot="header">
        <p class="font-label text-xs uppercase tracking-widest text-primary mb-2">{COPY.badge}</p>
        <h2 class="font-headline text-4xl md:text-5xl font-bold tracking-tight">{COPY.heading}</h2>
      </Fragment>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- Experts -->
      <div>
        <h3 class="font-headline text-lg font-bold uppercase text-muted mb-6">{COPY.expertsHeading}</h3>
        <div class="space-y-3">
          {COPY.experts.map((expert) => (
            <div class="flex items-center justify-between p-4 bg-surface">
              <div>
                <p class="font-bold text-lg">{expert.name}</p>
                <p class="font-label text-xs uppercase text-muted tracking-wider">{expert.domain}</p>
              </div>
              <span class="material-symbols-outlined text-accent-dark">verified</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Organizations -->
      <div>
        <h3 class="font-headline text-lg font-bold uppercase text-muted mb-6">{COPY.organizationsHeading}</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-foreground/10">
                <th class="py-4 font-label text-xs uppercase text-muted tracking-widest font-bold">{COPY.thInstitution}</th>
                <th class="py-4 font-label text-xs uppercase text-muted tracking-widest font-bold text-right">{COPY.thDomain}</th>
              </tr>
            </thead>
            <tbody class="text-sm font-medium">
              {COPY.organizations.map((org) => (
                <tr class="border-b border-border/20">
                  <td class="py-4">{org.name}</td>
                  <td class="py-4 text-right text-muted">{org.domain}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    </SectionWithIcon>
  </div>
</section>
