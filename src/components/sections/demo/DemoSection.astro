---
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import SectionWithIcon from '../../ui/SectionWithIcon.astro';
import Button from '../../ui/Button.astro';
import LinkArrow from '../../ui/LinkArrow.astro';
import DemoStage from './DemoStage.astro';

interface Link {
  label: string;
  href: string;
  icon?: string;
  sub?: string;
}

interface Stage {
  label?: string;
  title?: string;
  description: string;
  shape: string;
}

interface VideoPopover {
  mediaId: string;
  label: string;
}

interface Props extends HTMLAttributes<'section'> {
  badge?: string;
  heading: string;
  intro: string;
  stages?: Stage[];
  note?: string;
  cta?: Link;
  secondaryLinks?: Link[];
  videoPopover?: VideoPopover;
  icon?: ImageMetadata;
  class?: string;
}

const {
  badge,
  heading,
  intro,
  stages,
  note,
  cta,
  secondaryLinks,
  videoPopover,
  icon,
  class: className,
  ...rest
} = Astro.props;

const hasStages = stages && stages.length > 0;
---

<section
  class:list={['py-20 md:py-28 px-6 bg-surface-primary', className]}
  {...rest}
>
  <div class="max-w-screen-2xl mx-auto">
    <div class:list={['grid grid-cols-1 gap-12 lg:gap-16 items-start', hasStages && 'lg:grid-cols-12']}>
      <div class:list={[hasStages && 'lg:col-span-7']}>
        <SectionWithIcon icon={icon}>
          <Fragment slot="header">
            {badge && <span class="font-label text-primary text-sm mb-4">{badge}</span>}
            <h2 class="font-headline font-bold text-3xl md:text-5xl tracking-tight leading-[1.1] text-foreground" set:html={heading}></h2>
          </Fragment>

          <p class="text-muted text-lg leading-relaxed max-w-2xl mb-6">
            {intro}
          </p>

          <div class="space-y-6">
            {note && (
              <p class="text-sm text-muted italic max-w-2xl leading-relaxed">{note}</p>
            )}
            <div class="flex flex-col items-start gap-4">
              {(cta || videoPopover) && (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
                  {cta && (
                    <Button href={cta.href} external={cta.href.startsWith('http')} size="md" block trailingIcon={cta.icon}>
                      {cta.label}
                    </Button>
                  )}
                  {videoPopover && (
                    <Fragment>
                      <script is:inline async src="https://fast.wistia.com/player.js"></script>
                      <script is:inline async type="module" src={`https://fast.wistia.com/embed/${videoPopover.mediaId}.js`}></script>
                      <wistia-player
                        media-id={videoPopover.mediaId}
                        popover-content="link"
                        wistia-popover="true"
                        aspect="1.7777777777777777"
                        style="display: block;"
                        class="w-full"
                      >
                        <a href="#" class="flex items-center justify-center gap-2 w-full tracking-tight transition-all duration-300 bg-white text-primary border-2 border-primary hover:bg-primary hover:text-white px-10 py-4 text-base font-extrabold">
                          {videoPopover.label}
                          <span class="material-symbols-outlined text-lg" aria-hidden="true">play_arrow</span>
                        </a>
                      </wistia-player>
                    </Fragment>
                  )}
                </div>
              )}
              {secondaryLinks && secondaryLinks.length > 0 && (
                <div class="flex flex-wrap items-center gap-6">
                  {secondaryLinks.map((link) => (
                    <LinkArrow href={link.href} external={link.href.startsWith('http')} icon={link.icon}>
                      {link.label}
                    </LinkArrow>
                  ))}
                </div>
              )}
            </div>
          </div>
        </SectionWithIcon>
      </div>

      {hasStages && (
        <div class="lg:col-span-5 space-y-4">
          {stages!.map((stage) => (
            <DemoStage label={stage.label} title={stage.title} description={stage.description} shape={stage.shape} />
          ))}
        </div>
      )}
    </div>
  </div>
</section>
