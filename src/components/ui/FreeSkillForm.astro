---
import { localeFromPathname } from '../../lib/i18n';

type Size = 'md' | 'lg';
type Skill = 'audit' | 'planning';

interface Props {
  surface: string;
  skill: Skill;
  size?: Size;
  submitLabel?: string;
  placeholder?: string;
  successHeading?: string;
  successNote?: string;
  block?: boolean;
  fitContainer?: boolean;
  class?: string;
}

const locale = localeFromPathname(Astro.url.pathname);

const COPY_PL = {
  submitLabel: 'Odbierz darmowy skill',
  placeholder: 'adres email',
  successHeading: 'Gotowe. Sprawdź skrzynkę.',
  successNote: 'Ten darmowy skill odbierasz raz na adres email.',
  successRepeat: 'Masz go już? Link jest w pierwszym mailu.',
  emailLabel: 'Adres email',
  loadingLabel: 'Wysyłam...',
  errEmail: 'Podaj poprawny adres email.',
  errUnavailable: 'Mechanizm chwilowo niedostępny. Spróbuj ponownie za chwilę.',
  errGeneric: 'Wystąpił błąd. Spróbuj ponownie za chwilę.',
  errOffline: 'Brak połączenia. Sprawdź internet i spróbuj ponownie.',
  nextStep: 'Wyślemy Ci mailem osobisty link do instalacji.',
  disclaimerPrefix: 'Podając maila wyrażasz zgodę na otrzymywanie wiadomości o naszych produktach i usługach (zgodnie z ',
  disclaimerLinkLabel: 'Polityką prywatności',
  disclaimerSuffix: ').',
  privacyHref: '/ux-design-skill/polityka-prywatnosci/',
};

const COPY_EN = {
  submitLabel: 'Get the free skill',
  placeholder: 'email address',
  successHeading: 'Done. Check your inbox.',
  successNote: 'You can claim this free skill once per email address.',
  successRepeat: 'Have it already? Your link is in the first email.',
  emailLabel: 'Email address',
  loadingLabel: 'Sending...',
  errEmail: 'Enter a valid email address.',
  errUnavailable: 'Temporarily unavailable. Try again in a moment.',
  errGeneric: 'Something went wrong. Try again in a moment.',
  errOffline: 'No connection. Check your internet and try again.',
  nextStep: "We'll email you a personal install link.",
  disclaimerPrefix: 'By submitting your email you consent to receive product and service updates (per our ',
  disclaimerLinkLabel: 'Privacy Policy',
  disclaimerSuffix: ').',
  privacyHref: '/en/ux-design-skill/privacy-policy/',
};

const COPY = locale === 'en' ? COPY_EN : COPY_PL;

const {
  surface,
  skill,
  size = 'md',
  submitLabel = COPY.submitLabel,
  placeholder = COPY.placeholder,
  successHeading = COPY.successHeading,
  successNote = COPY.successNote,
  block = false,
  fitContainer = false,
  class: className,
} = Astro.props;

const privacyHref = COPY.privacyHref;
// The seen event's labels hold the same values as the other funnel events' labels, built in the script below.
const page = Astro.url.pathname;

const inputSizeClasses: Record<Size, string> = {
  md: 'px-6 py-4 text-base',
  lg: 'px-8 py-6 text-xl',
};

const buttonSizeClasses: Record<Size, string> = {
  md: 'px-10 py-4 text-base font-extrabold',
  lg: 'px-12 py-6 text-xl font-extrabold',
};

const iconSize: Record<Size, string> = {
  md: 'text-lg',
  lg: 'text-xl',
};
---

<div
  class:list={['free-skill-form', block && 'w-full', fitContainer && '@container', className]}
  data-surface={surface}
  data-skill={skill}
  data-state="idle"
  data-locale={locale}
  data-i18n-loading={COPY.loadingLabel}
  data-i18n-err-email={COPY.errEmail}
  data-i18n-err-unavailable={COPY.errUnavailable}
  data-i18n-err-generic={COPY.errGeneric}
  data-i18n-err-offline={COPY.errOffline}
  data-umami-seen="Free skill form seen"
  data-umami-seen-skill={skill}
  data-umami-seen-language={locale}
  data-umami-seen-surface={surface}
  data-umami-seen-page={page}
>
  <form
    class:list={['free-skill-form__form flex flex-col items-stretch gap-0 sm:gap-0', fitContainer ? '@sm:flex-row' : 'sm:flex-row']}
    novalidate
  >
    <label class="sr-only" for={`free-skill-email-${surface}`}>{COPY.emailLabel}</label>
    <input
      id={`free-skill-email-${surface}`}
      name="email"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder={placeholder}
      class:list={[
        'free-skill-form__input',
        'flex-1 min-w-0 bg-white text-foreground border-2 border-primary',
        fitContainer ? '@sm:border-r-0' : 'sm:border-r-0',
        'placeholder:text-muted/70 outline-none',
        'focus:bg-primary/5 transition-colors duration-200',
        inputSizeClasses[size],
      ]}
    />
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute opacity-0 pointer-events-none -z-10 h-0 w-0"
    />
    <button
      type="submit"
      class:list={[
        'free-skill-form__submit',
        'inline-flex items-center justify-center gap-2 tracking-tight cursor-pointer',
        fitContainer ? '@sm:shrink-0 @sm:px-6 @sm:whitespace-nowrap' : 'sm:flex-1 sm:basis-0',
        'transition-all duration-300',
        'bg-primary text-white border-2 border-primary hover:bg-black hover:border-black',
        'disabled:opacity-60 disabled:cursor-not-allowed',
        buttonSizeClasses[size],
      ]}
    >
      <span class="free-skill-form__submit-label">{submitLabel}</span>
      <span class:list={['material-symbols-outlined', iconSize[size]]} aria-hidden="true">mail</span>
    </button>
  </form>

  <p class="free-skill-form__disclaimer mt-3 text-sm text-muted leading-relaxed">
    <span class="free-skill-form__next-step block">{COPY.nextStep}</span>
    {COPY.disclaimerPrefix}<a href={privacyHref} class="underline hover:text-primary">{COPY.disclaimerLinkLabel}</a>{COPY.disclaimerSuffix}
  </p>

  <p
    class="free-skill-form__error mt-3 text-sm text-red-700 hidden"
    role="alert"
    aria-live="polite"
  ></p>

  <div class="free-skill-form__success hidden mt-2" role="status" aria-live="polite">
    <p class="text-lg font-bold text-foreground">
      <span class="material-symbols-outlined align-middle text-primary mr-2" aria-hidden="true">check_circle</span>
      <span class="free-skill-form__success-heading align-middle">{successHeading}</span>
    </p>
    <p class="text-muted mt-2 free-skill-form__success-note">{successNote}</p>
    <p class="text-muted mt-2 free-skill-form__success-repeat">{COPY.successRepeat}</p>
  </div>
</div>

<script>
  type FormState = 'idle' | 'loading' | 'success' | 'error';

  function setState(root: HTMLElement, state: FormState) {
    root.setAttribute('data-state', state);
  }

  function showError(root: HTMLElement, message: string) {
    const el = root.querySelector<HTMLElement>('.free-skill-form__error');
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function hideError(root: HTMLElement) {
    const el = root.querySelector<HTMLElement>('.free-skill-form__error');
    if (!el) return;
    el.textContent = '';
    el.classList.add('hidden');
  }

  // The personal install link comes only by email; the page never shows it.
  function showSuccess(root: HTMLElement) {
    const form = root.querySelector<HTMLElement>('.free-skill-form__form');
    const disclaimer = root.querySelector<HTMLElement>('.free-skill-form__disclaimer');
    const success = root.querySelector<HTMLElement>('.free-skill-form__success');
    if (!form || !success) return;
    form.classList.add('hidden');
    disclaimer?.classList.add('hidden');
    success.classList.remove('hidden');
  }

  // Funnel events carry only these labels, never the email or anything else the visitor typed.
  type FunnelData = { skill: string; language: string; surface: string; page: string };
  // Why a submit failed, as the visitor was told; never the server's message or the typed address.
  type SubmitErrorReason = 'invalid_email' | 'not_configured' | 'server_error' | 'offline';
  // Where a server_error came from: the site's HTTP status, the Easytools step that failed and Easytools'
  // HTTP status (0: no answer). `stage` is "none" when the answer named no step, e.g. a platform timeout page.
  type ServerErrorData = { site_status: number; stage: string; easytools_status?: number };
  type EventData = FunnelData & { reason?: SubmitErrorReason } & Partial<ServerErrorData>;
  const FAILED_STAGES = new Set(['grant']);

  // Umami loads as a deferred script and may be blocked, so every call checks it is there.
  function trackUmami(name: string, data: EventData) {
    const u = window as unknown as { umami?: { track: (name: string, data?: EventData) => void } };
    if (u.umami && typeof u.umami.track === 'function') {
      u.umami.track(name, data);
    }
  }

  function trackSubmitError(funnel: FunnelData, reason: SubmitErrorReason, server?: ServerErrorData) {
    trackUmami('Free skill submit error', { ...funnel, reason, ...server });
  }

  /** Only known step names and whole-number statuses pass, so nothing else from the answer reaches analytics. */
  function serverErrorData(siteStatus: number, payload: { stage?: unknown; status?: unknown }): ServerErrorData {
    const stage = typeof payload.stage === 'string' && FAILED_STAGES.has(payload.stage) ? payload.stage : 'none';
    const data: ServerErrorData = { site_status: siteStatus, stage };
    if (stage !== 'none' && Number.isInteger(payload.status)) data.easytools_status = payload.status as number;
    return data;
  }

  // The email goes only to the Meta helper, which sends its SHA-256 hash with marketing consent, never the address.
  function trackLead(surface: string, skill: string, funnel: FunnelData, email: string) {
    const w = window as unknown as {
      trackConversion?: (event: string, params: Record<string, string>, user?: { email?: string }) => void;
    };
    if (typeof w.trackConversion === 'function') {
      w.trackConversion('Lead', { content_name: `free_${skill}_skill`, content_id: surface }, { email });
    }
    trackUmami(`Free skill submit: ${surface}`, funnel);
  }

  function attach(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('.free-skill-form__form');
    const submit = root.querySelector<HTMLButtonElement>('.free-skill-form__submit');
    const submitLabel = root.querySelector<HTMLElement>('.free-skill-form__submit-label');
    const surface = root.dataset.surface ?? 'unknown';
    const skill = root.dataset.skill ?? '';
    if (!form || !submit || !submitLabel) return;

    const i18n = {
      loading: root.dataset.i18nLoading ?? 'Sending...',
      errEmail: root.dataset.i18nErrEmail ?? 'Enter a valid email address.',
      errUnavailable: root.dataset.i18nErrUnavailable ?? 'Temporarily unavailable. Try again in a moment.',
      errGeneric: root.dataset.i18nErrGeneric ?? 'Something went wrong. Try again in a moment.',
      errOffline: root.dataset.i18nErrOffline ?? 'No connection. Check your internet and try again.',
    };

    const originalLabel = submitLabel.textContent ?? '';
    const locale = root.dataset.locale ?? 'pl';
    const funnel: FunnelData = { skill, language: locale, surface, page: window.location.pathname };

    // The first change to the email field while the visitor is in it counts as starting the form, once per
    // form per page load. Autofill can also fill email fields the visitor is not in; such a change neither
    // counts nor uses up that form's start.
    const emailInput = root.querySelector<HTMLInputElement>('input[name="email"]');
    if (emailInput) {
      const onEmailInput = () => {
        if (document.activeElement !== emailInput) return;
        emailInput.removeEventListener('input', onEmailInput);
        trackUmami('Free skill form started', funnel);
      };
      emailInput.addEventListener('input', onEmailInput);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError(root);

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const website = String(data.get('website') ?? '');

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError(root, i18n.errEmail);
        trackSubmitError(funnel, 'invalid_email');
        return;
      }

      setState(root, 'loading');
      submit.disabled = true;
      submitLabel.textContent = i18n.loading;

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website, locale, skill }),
        });

        const payload = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          granted?: boolean;
          reason?: string;
          stage?: unknown;
          status?: unknown;
        };

        // Only a real grant says `granted`; the honeypot's bare `ok` falls through to the generic error.
        if (res.ok && payload.ok && payload.granted === true) {
          setState(root, 'success');
          trackLead(surface, skill, funnel, email);
          showSuccess(root);
          return;
        }

        if (payload.reason === 'invalid_email') {
          showError(root, i18n.errEmail);
          trackSubmitError(funnel, 'invalid_email');
        } else if (payload.reason === 'not_configured') {
          showError(root, i18n.errUnavailable);
          trackSubmitError(funnel, 'not_configured');
        } else {
          showError(root, i18n.errGeneric);
          trackSubmitError(funnel, 'server_error', serverErrorData(res.status, payload));
        }
        setState(root, 'error');
      } catch (_err) {
        showError(root, i18n.errOffline);
        trackSubmitError(funnel, 'offline');
        setState(root, 'error');
      } finally {
        submit.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.free-skill-form').forEach(attach);
</script>
