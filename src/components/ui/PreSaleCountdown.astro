---
import { localeFromPathname } from '../../lib/i18n';
import {
  SALE_START_MS,
  SALE_END_MS,
  SALE_PREFIX,
  getRemaining,
  formatRemaining,
} from '../../lib/presale';

interface Props {
  // false renders only the sale-window script (for sections that swap prices
  // and links but show no countdown of their own).
  showCountdown?: boolean;
}

const { showCountdown = true } = Astro.props;

const locale = localeFromPathname(Astro.url.pathname);
const initialRemaining = getRemaining(Date.now());
const initialText = initialRemaining ? formatRemaining(initialRemaining, locale) : '';
const prefix = SALE_PREFIX[locale];

// Page-wide contract, server-rendered for build time and kept right in the
// browser by the script below, at both edges of the sale window:
// - [data-sale-only] shows only inside the window, [data-list-only] only outside it;
// - an element with data-list-href and data-sale-href gets the matching href;
// - [data-sale-countdown] shows the time left until the window ends, and hides itself outside it.
// A tab left open across an edge flips without a reload; a stale build
// corrects itself on load.
---

{showCountdown && (
  <span
    class="inline-flex items-baseline gap-1.5"
    data-sale-countdown
    data-sale-locale={locale}
    style={initialRemaining ? undefined : 'display:none'}
  >
    <span>{prefix}</span>
    <span class="font-bold" data-sale-body>{initialText}</span>
  </span>
)}

<script is:inline define:vars={{ SALE_START_MS, SALE_END_MS }}>
  (function () {
    // The component can appear more than once on a page; one script does the work.
    if (window.__saleWindowStarted) return;
    window.__saleWindowStarted = true;

    function polishPlural(n, one, few, many) {
      if (n === 1) return one;
      var m10 = n % 10;
      var m100 = n % 100;
      if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
      return many;
    }

    function formatRemaining(r, locale) {
      var parts = [];
      if (locale === 'pl') {
        if (r.days > 0) parts.push(r.days + ' ' + (r.days === 1 ? 'dzień' : 'dni'));
        if (r.hours > 0 || r.days > 0) parts.push(r.hours + ' ' + polishPlural(r.hours, 'godzina', 'godziny', 'godzin'));
        parts.push(r.minutes + ' min');
        parts.push(r.seconds + ' sek');
      } else {
        if (r.days > 0) parts.push(r.days + ' ' + (r.days === 1 ? 'day' : 'days'));
        if (r.hours > 0 || r.days > 0) parts.push(r.hours + ' ' + (r.hours === 1 ? 'hour' : 'hours'));
        parts.push(r.minutes + ' min');
        parts.push(r.seconds + ' sec');
      }
      return parts.join(' ');
    }

    function show(el, visible) {
      if (visible) el.style.removeProperty('display');
      else el.style.display = 'none';
    }

    var applied = null;
    function apply(inSale) {
      if (applied === inSale) return;
      applied = inSale;
      document.querySelectorAll('[data-sale-only], [data-sale-countdown]').forEach(function (el) { show(el, inSale); });
      document.querySelectorAll('[data-list-only]').forEach(function (el) { show(el, !inSale); });
      document.querySelectorAll('[data-list-href][data-sale-href]').forEach(function (el) {
        el.setAttribute('href', el.getAttribute(inSale ? 'data-sale-href' : 'data-list-href'));
      });
    }

    function updateCountdowns(now) {
      var diff = SALE_END_MS - now;
      var r = {
        days: Math.floor(diff / 86400000),
        hours: Math.floor((diff % 86400000) / 3600000),
        minutes: Math.floor((diff % 3600000) / 60000),
        seconds: Math.floor((diff % 60000) / 1000),
      };
      document.querySelectorAll('[data-sale-countdown]').forEach(function (el) {
        var bodyEl = el.querySelector('[data-sale-body]');
        if (bodyEl) bodyEl.textContent = formatRemaining(r, el.getAttribute('data-sale-locale') || 'pl');
      });
    }

    // Returns false once the window is over: nothing changes after that.
    function tick() {
      var now = Date.now();
      var inSale = now >= SALE_START_MS && now < SALE_END_MS;
      apply(inSale);
      if (inSale) updateCountdowns(now);
      return now < SALE_END_MS;
    }

    function start() {
      if (!tick()) return;
      var iv = setInterval(function () {
        if (!tick()) clearInterval(iv);
      }, 1000);
    }

    // The script can sit above blocks it swaps (the hero comes before the pricing cards).
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>
